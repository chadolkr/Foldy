---
import { Image } from 'astro:assets';
import { locales, localeHref, type Locale } from '../i18n';
import { getLatestRelease, RELEASES_URL, REPO } from '../lib/release';
import Icon from './Icon.astro';

import appIcon from '../../../assets/icons/png/foldy-128.png';

// 화면 사진: 그 언어의 앱 화면(assets/help/images/<앱 언어>/)이 있으면 그것을, 없으면 한국어판(docs/images/).
// 언어별 화면은 build/doc-screenshots.ps1 -Lang en -Out assets\help\images\en 으로 찍는다.
type Img = { default: ImageMetadata };
const korean = import.meta.glob<Img>('../../../docs/images/{main,quicksearch,quicksearch-calc,quicksearch-talk,analysis,guide,para-organize,para-template,mcp}.png', { eager: true });
const localized = import.meta.glob<Img>('../../../assets/help/images/*/{main,quicksearch,quicksearch-calc,quicksearch-talk,analysis,guide,para-organize,para-template,mcp}.png', { eager: true });
// (glob은 쓰는 그림만 고른다: 위 files와 같은 목록)
const files: Record<string, string> = {
  main: 'main.png', quicksearch: 'quicksearch.png', quicksearchCalc: 'quicksearch-calc.png', quicksearchTalk: 'quicksearch-talk.png',
  analysis: 'analysis.png', guide: 'guide.png', paraOrganize: 'para-organize.png', paraTemplate: 'para-template.png', mcp: 'mcp.png',
};

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = locale.dict;
const release = await getLatestRelease();
const repoUrl = `https://github.com/${REPO}`;
const lines = (s: string) => s.split('\n');

// "안전한가요?" 근거 링크 (글은 i18n의 safety.proof.items, 주소는 여기 한 곳에만)
const proofLinks: Record<string, string> = {
  source: repoUrl,
  build: `${repoUrl}/actions/workflows/release.yml`,
  attest: `${repoUrl}/attestations`,
  virus: `${repoUrl}/releases/latest`,
  codeql: `${repoUrl}/actions/workflows/codeql.yml`,
  scorecard: 'https://scorecard.dev/viewer/?uri=github.com/chadolkr/Foldy',
  review: `${repoUrl}/blob/main/docs/reviews/2026-11-19-security-review.md`,
  network: `${localeHref(locale.path)}privacy/`,
};
// 공식 주소: 가짜 사이트와 구별하도록 글자 그대로 보여 준다 (SECURITY.md와 같게)
// Microsoft Store 판 (Store ID 9NS1PWL5QGP6, 이름 Foldy File Manager)
const STORE_URL = 'https://apps.microsoft.com/detail/9NS1PWL5QGP6';

const OFFICIAL = [
  { label: 'github.com/chadolkr/Foldy', href: repoUrl },
  { label: 'chadolkr.github.io/Foldy', href: 'https://chadolkr.github.io/Foldy/' },
];

let usedKorean = false;
const img = (k: string): ImageMetadata => {
  const file = files[k];
  const own = localized[`../../../assets/help/images/${locale.appLang}/${file}`];
  if (own && locale.appLang !== 'ko') return own.default;
  if (locale.appLang !== 'ko') usedKorean = true;
  return korean[`../../../docs/images/${file}`].default;
};
// 머리글보다 먼저 한 번 훑어서, 한국어판으로 대신한 그림이 있을 때만 안내 한 줄을 보인다.
Object.keys(files).forEach(img);
---

<a class="skip" href="#main">{t.nav.skip}</a>

<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="#">
      <Image src={appIcon} alt="" width={32} height={32} />
      <span>Foldy</span>
    </a>
    <nav aria-label="Foldy">
      <a href="#features">{t.nav.features}</a>
      <a href="#safety">{t.nav.safety}</a>
      <a href="#install">{t.nav.install}</a>
      <a href="#faq">{t.nav.faq}</a>
      <a href={repoUrl} rel="noopener">{t.nav.github}</a>
    </nav>
    <details class="lang">
      <summary aria-label={t.nav.language}><Icon name="globe" /><span>{locale.name}</span></summary>
      <ul>
        {locales.map((l) => (
          <li><a href={localeHref(l.path)} hreflang={l.htmlLang} lang={l.htmlLang} aria-current={l.path === locale.path ? 'page' : undefined}>{l.name}</a></li>
        ))}
      </ul>
    </details>
    <a class="btn btn-small" href={release.msiUrl}>{t.nav.download}</a>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="wrap hero-inner">
      <Image class="hero-icon" src={appIcon} alt="" width={88} height={88} loading="eager" />
      <a class="hero-badge" href="#new">{t.news.badge}</a>
      <h1>{lines(t.hero.title).map((l, i) => (i ? <><br />{l}</> : l))}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-big" href={release.msiUrl}>
          <Icon name="download" />
          <span>{t.hero.download}</span>
        </a>
        <a class="btn btn-ghost btn-big" href="#features">{t.hero.secondary}</a>
      </div>
      <p class="hero-req">
        {release.version && <span class="pill">{t.hero.versionPrefix} {release.version}</span>}
        {t.hero.requirements}
      </p>
    </div>
    <div class="wrap">
      <figure class="shot shot-hero">
        <Image src={img('main')} alt={t.hero.imageAlt} widths={[800, 1600]} sizes="(max-width: 1160px) 100vw, 1120px" loading="eager" />
      </figure>
      {usedKorean && t.shotsNote && <p class="shots-note">{t.shotsNote}</p>}
    </div>
  </section>

  <section class="highlights" aria-label="Foldy">
    <div class="wrap highlight-grid">
      {t.highlights.map((h) => (
        <div class="highlight">
          <strong>{h.value}</strong>
          <span>{h.label}</span>
          <small>{h.note}</small>
        </div>
      ))}
    </div>
  </section>

  <section id="new" class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">{t.news.eyebrow}</p>
        <h2>{t.news.title}</h2>
        <p class="section-lead">{t.news.lead}</p>
      </header>
      <ul class="card-grid">
        {t.news.items.map((m) => (
          <li class="card">
            <span class="card-icon"><Icon name={m.icon} /></span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ul>
      <p class="center news-link"><a href={release.pageUrl}>{t.news.link} →</a></p>
    </div>
  </section>

  <section id="features" class="section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">{t.features.eyebrow}</p>
        <h2>{t.features.title}</h2>
        <p class="section-lead">{t.features.lead}</p>
        <ol class="toc">
          {t.features.items.map((f, i) => (
            <li><a href={`#${f.id}`}><span class="num">{i + 1}</span>{f.kicker}</a></li>
          ))}
        </ol>
      </header>

      {t.features.items.map((f, i) => (
        <article id={f.id} class:list={['feature', { flip: i % 2 === 1 }]}>
          <div class="feature-text">
            <p class="kicker"><span class="num">{i + 1}</span>{f.kicker}<kbd>{f.key}</kbd></p>
            <h3>{lines(f.title).map((l, j) => (j ? <><br />{l}</> : l))}</h3>
            <p class="feature-summary">{f.summary}</p>
            <dl class="points">
              {f.points.map((p) => (
                <div>
                  <dt><Icon name="check" />{p.title}</dt>
                  <dd>{p.text}</dd>
                </div>
              ))}
            </dl>
            <p class="note"><Icon name="info" />{f.note}</p>
          </div>
          <div class="feature-media">
            <figure class="shot">
              <a href={img(f.img).src} title={t.zoom}><Image src={img(f.img)} alt={f.imgAlt} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" /></a>
            </figure>
            {f.extra.length > 0 && (
              <div class:list={['extra', { single: f.extra.length === 1 }]}>
                {f.extra.map((e) => (
                  <figure class="shot shot-small">
                    <a href={img(e.img).src} title={t.zoom}><Image src={img(e.img)} alt={e.alt} widths={[400, 800]} sizes="(max-width: 900px) 50vw, 280px" /></a>
                  </figure>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">{t.more.eyebrow}</p>
        <h2>{t.more.title}</h2>
        <p class="section-lead">{t.more.lead}</p>
      </header>
      <ul class="card-grid">
        {t.more.items.map((m) => (
          <li class="card">
            <span class="card-icon"><Icon name={m.icon} /></span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="ai" class="section">
    <div class="wrap feature flip">
      <div class="feature-text">
        <p class="eyebrow">{t.ai.eyebrow}</p>
        <h2>{t.ai.title}</h2>
        <p class="feature-summary">{t.ai.lead}</p>
        <p class="apps">{t.ai.apps}</p>
        <p class="examples-title">{t.ai.examplesTitle}</p>
        <ul class="examples">
          {t.ai.examples.map((e) => <li>{e}</li>)}
        </ul>
        <ul class="ticks">
          {t.ai.points.map((p) => <li><Icon name="check" />{p}</li>)}
        </ul>
        <p class="note"><Icon name="info" />{t.ai.footnote}</p>
      </div>
      <div class="feature-media">
        <figure class="shot">
          <a href={img(t.ai.img).src} title={t.zoom}><Image src={img(t.ai.img)} alt={t.ai.imgAlt} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" /></a>
        </figure>
      </div>
    </div>
  </section>

  <section id="safety" class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">{t.safety.eyebrow}</p>
        <h2>{t.safety.title}</h2>
      </header>
      <ul class="card-grid card-grid-4">
        {t.safety.items.map((s, i) => (
          <li class="card">
            <span class="card-icon"><Icon name={['offline', 'disk', 'eyeoff', 'code'][i]} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
      <p class="center"><a class="link" href={`${localeHref(locale.path)}privacy/`}>{t.safety.link} →</a></p>

      <div id="proof" class="proof">
        <h3>{t.safety.proof.title}</h3>
        <p class="muted">{t.safety.proof.lead}</p>
        <ul class="proof-list">
          {t.safety.proof.items.map((p) => (
            <li>
              <Icon name="check" />
              <div>
                <h4>{p.title}</h4>
                <p>{p.text}</p>
                <a class="link" href={proofLinks[p.id]} rel="noopener">{p.link} →</a>
              </div>
            </li>
          ))}
        </ul>
        <p class="center"><a class="link" href={`${repoUrl}/blob/main/SECURITY.md`}>{t.safety.proof.more} →</a></p>
      </div>

      <div id="fake" class="fake">
        <h3><Icon name="shield" />{t.safety.fake.title}</h3>
        <p>{t.safety.fake.lead}</p>
        <div class="fake-official">
          <p class="fake-label">{t.safety.fake.officialTitle}</p>
          <ul>
            {OFFICIAL.map((u) => <li><a href={u.href}><code>{u.label}</code></a></li>)}
          </ul>
          <p class="muted"><a href={STORE_URL} rel="noopener">{t.safety.fake.store}</a></p>
        </div>
        <ul class="fake-points">
          {t.safety.fake.points.map((x) => <li><Icon name="info" />{x}</li>)}
        </ul>
        <p class="fake-label">{t.safety.fake.checkTitle}</p>
        <ol class="fake-checks">
          {t.safety.fake.checks.map((x) => <li>{x}</li>)}
        </ol>
        <p class="fake-report">{t.safety.fake.report} <a class="link" href={`${repoUrl}/issues/new`}>{t.safety.fake.reportLink} →</a></p>
      </div>
    </div>
  </section>

  <section id="why" class="section">
    <div class="wrap narrow center why">
      <p class="eyebrow">{t.why.eyebrow}</p>
      <blockquote>
        <p>“{lines(t.why.quote).map((l, i) => (i ? <><br />{l}</> : l))}”</p>
        <footer>{t.why.by}</footer>
      </blockquote>
      <p class="section-lead">{t.why.text}</p>
      <a class="link" href={`${repoUrl}/issues`}>{t.why.link} →</a>
    </div>
    <div id="gpl" class="wrap narrow gpl">
      <h3>{t.gpl.title}</h3>
      <p class="muted">{t.gpl.lead}</p>
      <ul>
        {t.gpl.items.map((g) => (
          <li><strong>{g.title}</strong><span>{g.text}</span></li>
        ))}
      </ul>
      <a class="link" href="https://www.gnu.org/licenses/gpl-3.0.html" rel="noopener">{t.gpl.link} →</a>
    </div>
  </section>

  <section id="install" class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">{t.install.eyebrow}</p>
        <h2>{t.install.title}</h2>
      </header>
      <ol class="steps">
        {t.install.steps.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="install-box">
        <a class="btn btn-big" href={release.msiUrl}>
          <Icon name="download" />
          <span>{t.hero.download}</span>
        </a>
        <p class="hero-req">
          {release.version && <span class="pill">{t.hero.versionPrefix} {release.version}</span>}
          {t.hero.requirements}
        </p>
        <p class="warn"><Icon name="shield" />{t.install.warning}</p>
        <p class="muted">{t.install.uninstall}</p>
        <a class="link" href={`${repoUrl}/releases`}>{t.install.allReleases} →</a>
        <a class="link" href={STORE_URL} rel="noopener">{t.install.store} →</a>
        <p class="muted">{t.install.storeNote}</p>
      </div>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="wrap narrow">
      <header class="section-head">
        <h2>{t.faq.title}</h2>
      </header>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tint cta">
    <div class="wrap center">
      <Image src={appIcon} alt="" width={64} height={64} />
      <h2>{t.cta.title}</h2>
      <p class="section-lead">{t.cta.text}</p>
      <a class="btn btn-big" href={release.msiUrl}>
        <Icon name="download" />
        <span>{t.hero.download}</span>
      </a>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-inner">
    <div>
      <p><strong>Foldy</strong> · {t.footer.made} · {t.footer.license}</p>
      <p class="muted">{t.footer.note}</p>
    </div>
    <nav aria-label="Foldy links">
      <a href={repoUrl}>{t.footer.source}</a>
      <a href={`${localeHref(locale.path)}privacy/`}>{t.footer.privacy}</a>
      <a href={`${repoUrl}/blob/main/SECURITY.md`}>{t.footer.security}</a>
      <a href={`${repoUrl}/issues`}>{t.footer.issues}</a>
      <a href={RELEASES_URL}>{t.nav.download}</a>
    </nav>
  </div>
</footer>
