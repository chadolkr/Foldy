<UserControl x:Class="Foldy.UI.Markdown.MarkdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Foldy.UI.Localization"
             xmlns:md="clr-namespace:Foldy.UI.Markdown"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="{DynamicResource Font.UI}"
             FontSize="{DynamicResource Font.Size}"
             Focusable="True">
  <!--
    내장 Markdown 뷰어 (설계서 5.9). DataContext = Foldy.Presentation.Tabs.MarkdownTabViewModel.
    색·글꼴은 모두 DynamicResource 토큰 → 라이트/다크/레트로가 바로 바뀐다.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- 툴바 토글 (원문 보기, 목차). 공용 테마에 ToggleButton 스타일이 없어 여기서 토큰만으로 만든다. -->
    <Style x:Key="Md.ToggleButton" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius}"
                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionText}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Md.Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 툴바 -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1" Padding="4,2">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="BackButton" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72B;"
                  ToolTip="{loc:T pane.back}" Click="OnBack" IsEnabled="{Binding CanGoBack}" />
          <Button x:Name="ForwardButton" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72A;"
                  ToolTip="{loc:T pane.forward}" Click="OnForward" IsEnabled="{Binding CanGoForward}" />
          <ToggleButton x:Name="SourceToggle" Style="{StaticResource Md.ToggleButton}" ToolTip="{loc:T md.source.tip}"
                        IsChecked="{Binding ShowSource, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Md.Glyph}" Text="&#xE943;" />
              <TextBlock Text="{loc:T md.source}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="OutlineToggle" Style="{StaticResource Md.ToggleButton}" ToolTip="{loc:T md.toc.tip}"
                        IsChecked="{Binding IsOutlineVisible, RelativeSource={RelativeSource AncestorType=md:MarkdownView}, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Md.Glyph}" Text="&#xE8FD;" />
              <TextBlock Text="{loc:T md.toc}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE70F;" ToolTip="{loc:T md.edit.tip}" Click="OnEdit" />
          <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE721;" ToolTip="{loc:T md.find}" Click="OnShowFind" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{DynamicResource Foldy.StatusText}" HorizontalAlignment="Right"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
      </DockPanel>
    </Border>

    <!-- 원격 이미지 차단 안내 -->
    <Border x:Name="ImageBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:T md.loadImages}" Padding="10,2" Click="OnAllowRemoteImages" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{loc:T md.imagesBlocked}" />
      </DockPanel>
    </Border>

    <!-- 찾기 막대 -->
    <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,3">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE711;" ToolTip="{loc:T md.close}" Click="OnCloseFind" />
        <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE74B;" ToolTip="{loc:T md.next}" Click="OnFindNext" />
        <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE74A;" ToolTip="{loc:T md.prev}" Click="OnFindPrevious" />
        <TextBlock x:Name="FindCount" DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <Border Style="{DynamicResource Foldy.InputBorder}">
          <TextBox x:Name="FindBox" TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
        </Border>
      </DockPanel>
    </Border>

    <!-- 본문: 목차 | 문서 -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Width="220" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
              Background="{DynamicResource Brush.Surface}"
              Visibility="{Binding IsOutlineVisible, RelativeSource={RelativeSource AncestorType=md:MarkdownView}, Converter={StaticResource BoolToVis}}">
        <ListBox x:Name="OutlineList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Text}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnOutlineSelected"
                 VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type md:MarkdownHeading}">
              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"
                         Margin="{Binding Indent, Converter={x:Static md:MarkdownView.IndentConverter}}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <FlowDocumentScrollViewer x:Name="Viewer" Grid.Column="1" IsToolBarVisible="False" IsSelectionEnabled="True"
                                IsInactiveSelectionHighlightEnabled="True" Focusable="True"
                                Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
                                SelectionBrush="{DynamicResource Brush.Accent}"
                                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />

      <TextBox x:Name="SourceBox" Grid.Column="1" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="True"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               FontFamily="{DynamicResource Font.Mono}" FontSize="13" Padding="16,10"
               Background="{DynamicResource Brush.Window}" />
    </Grid>
  </Grid>
</UserControl>
