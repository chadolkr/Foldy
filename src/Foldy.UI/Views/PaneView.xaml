<UserControl x:Class="Foldy.UI.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="clr-namespace:Foldy.UI.Controls"
             xmlns:tabs="clr-namespace:Foldy.Presentation.Tabs;assembly=Foldy.Presentation"
             xmlns:tree="clr-namespace:Foldy.Presentation.Tree;assembly=Foldy.Presentation"
             Background="{DynamicResource Brush.Surface}">
  <UserControl.Resources>
    <!-- OneNote 스타일 탭: 탭마다 색, 활성 탭은 진하게 + 아래 내용과 이어짐 -->
    <DataTemplate x:Key="TabTemplate" DataType="{x:Type tabs:TabBase}">
      <Border x:Name="TabRoot" fc:ThemeBrush.TabBackground="{Binding ColorIndex}"
              CornerRadius="7,7,0,0" Margin="0,0,3,0" Padding="10,0,4,0" Height="30" MinWidth="72" MaxWidth="220"
              Cursor="Hand" Opacity="0.72" ToolTip="{Binding Location}" Tag="{Binding}"
              MouseLeftButtonDown="OnTabMouseDown" MouseMove="OnTabMouseMove" MouseUp="OnTabMouseUp"
              AllowDrop="True" Drop="OnTabDrop" DragOver="OnTabDragOver">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Glyph" Text="&#xE8B7;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Text}" FontSize="{DynamicResource Font.Size}" />
          <Button x:Name="CloseBtn" Grid.Column="2" Style="{DynamicResource Foldy.ToolButton}" Width="28" Height="28" FontSize="10"
                  Margin="4,0,0,0" Content="&#xE711;" ToolTip="탭 닫기 (Ctrl+W)" Click="OnCloseTab" Tag="{Binding}" Opacity="0.45" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Markdown">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE8A5;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Search">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE721;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsBusy}" Value="True">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE895;" />
        </DataTrigger>
        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="TabRoot" Property="Opacity" Value="0.9" />
          <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="CloseBtn" Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="TabRoot" Property="Opacity" Value="0.9" />
          <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <HierarchicalDataTemplate DataType="{x:Type tree:FolderNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="0,0,6,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 1행: 탭 줄 + 새 탭 + 드라이브 칩 -->
    <Grid Grid.Row="0" Margin="8,6,8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                      PreviewMouseWheel="OnTabWheel" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
          <ItemsControl x:Name="TabStrip" ItemTemplate="{StaticResource TabTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <Button Style="{DynamicResource Foldy.ToolButton}" Width="28" Height="28" FontSize="12" Content="&#xE710;"
                ToolTip="새 탭 (Ctrl+T)" Click="OnNewTab" VerticalAlignment="Bottom" />
      </StackPanel>
      <ItemsControl x:Name="DriveStrip" Grid.Column="1" VerticalAlignment="Center" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 드라이브 칩: 본문 글자색·13px·굵게, 테두리로 버튼임을 드러낸다 (모든 테마에서 대비 4.5:1 이상) -->
            <Button Style="{DynamicResource Foldy.DriveChip}" Click="OnDriveClick" Tag="{Binding}">
              <Button.ToolTip>
                <StackPanel>
                  <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SpaceText}" />
                </StackPanel>
              </Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEDA2;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding Letter}" Foreground="{DynamicResource Brush.Text}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- 활성 탭 색 띠: 탭과 내용이 이어져 보이게 (활성 패널이면 강조색 선 추가) -->
    <Border x:Name="TabBand" Grid.Row="1" Margin="8,0,8,0" />
    <Border x:Name="ActiveLine" Grid.Row="1" Margin="8,0,8,0" Height="2" VerticalAlignment="Bottom"
            Background="{DynamicResource Brush.Accent}" Visibility="Hidden" />

    <!-- 2행: 이동 버튼, 브레드크럼, 새로 고침, 터미널 (오른쪽 끝 고정 자리) -->
    <Grid Grid.Row="2" Margin="8,6,8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
        <Button x:Name="TreeBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE8A0;" ToolTip="폴더 트리 숨기기 (Ctrl+B)"
                AutomationProperties.Name="폴더 트리 보이기/숨기기" Click="OnToggleTree" Margin="0,0,6,0" />
        <Button x:Name="BackBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72B;" ToolTip="뒤로 (Alt+←)" Click="OnBack" />
        <Button x:Name="ForwardBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72A;" ToolTip="앞으로 (Alt+→)" Click="OnForward" />
        <Button x:Name="UpBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE74A;" ToolTip="위로 (Alt+↑)" Click="OnUp" />
      </StackPanel>
      <Grid Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <fc:BreadcrumbBar x:Name="Crumbs" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border x:Name="SlowChip" Margin="6,0,0,0" Padding="8,0" CornerRadius="6" Height="32" Visibility="Collapsed"
                  Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  ToolTip="이 드라이브는 응답이 느려서 미리보기·썸네일·Git 감지를 줄였습니다" ToolTipService.InitialShowDelay="300">
            <TextBlock Text="느린 드라이브" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
          <!-- Git 브랜치 칩: 저장소 안에서만 보인다 (DESIGN.md Git 통합) -->
          <Border x:Name="GitChip" Margin="6,0,0,0" Padding="8,0" CornerRadius="6" Height="32" Cursor="Hand"
                  MouseLeftButtonUp="OnGitChipClick" ToolTipService.InitialShowDelay="300"
                  Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock x:Name="GitText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border x:Name="SearchBorder" Grid.Column="2" Style="{DynamicResource Foldy.InputBorder}" Width="200" Margin="6,0,0,0">
        <Grid>
          <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False" />
          <TextBlock x:Name="SearchHint" Text="파일 이름 검색 (Ctrl+F)" Margin="28,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextDisabled}" IsHitTestVisible="False" />
          <TextBox x:Name="SearchBox" Padding="24,0,6,0" KeyDown="OnSearchKey" TextChanged="OnSearchTextChanged" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
        <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72C;" ToolTip="새로 고침 (Ctrl+R)" Click="OnRefresh" />
        <Button x:Name="ImagesBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xEB9F;" ToolTip="이미지만 보기 (Ctrl+Shift+I)" Click="OnToggleImages" Visibility="Collapsed" />
        <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource Brush.Border}" />
        <!-- 탭 종류에 따라 같은 자리의 터미널 아이콘이 바뀐다 (DESIGN.md): 로컬 = CMD·PowerShell·관리자, SFTP = SSH·sudo -->
        <Button x:Name="CmdBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE756;" ToolTip="명령 프롬프트로 이 폴더 열기 (Ctrl+클릭: 관리자)" AutomationProperties.Name="명령 프롬프트" Click="OnCmd" />
        <Button x:Name="PsBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE943;" ToolTip="PowerShell로 이 폴더 열기 (Ctrl+`) · Ctrl+클릭: 관리자" AutomationProperties.Name="PowerShell" Click="OnPowerShell" />
        <Button x:Name="AdminBtn" Style="{DynamicResource Foldy.ToolButton}" Content="&#xEA18;" ToolTip="PowerShell(관리자)로 이 폴더 열기 (Ctrl+Shift+`)" AutomationProperties.Name="PowerShell 관리자" Click="OnAdminShell" />
        <Button x:Name="SshBtn" Style="{DynamicResource Foldy.ToolButton}" Width="Auto" Padding="8,0" Visibility="Collapsed"
                ToolTip="같은 서버·계정·폴더로 SSH 터미널 (Ctrl+`)" Click="OnSsh">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE756;" FontFamily="{DynamicResource Font.Icon}" VerticalAlignment="Center" />
            <TextBlock Text=" SSH" FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- 3행: Git 바 (저장소 안에서만. 높이를 0에서 빠르게 펼쳐 목록이 튀지 않게 한다) -->
    <!-- 3행: 한 줄 안내들 (Git 바, 관리 방식, 작업 태그) -->
    <StackPanel Grid.Row="3">
    <Border x:Name="GitBar" Height="0" Margin="8,0,8,0" ClipToBounds="True" Visibility="Collapsed">
      <Border Height="32" VerticalAlignment="Top" Margin="0,0,0,6" Padding="10,0,4,0" CornerRadius="{DynamicResource Radius}"
              Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock x:Name="GitBarBranch" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock x:Name="GitBarChanges" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="Git 화면 열기" Margin="2,3" Padding="10,0" Click="OnGitBarOpen"
                  ToolTip="커밋 기록, 변경 내용 비교, 커밋 만들기를 한 화면에서" />
          <Button DockPanel.Dock="Right" Content="커밋…" Margin="2,3" Padding="10,0" Click="OnGitBarCommit"
                  ToolTip="Git 화면에서 변경한 파일을 골라 커밋합니다" />
          <Button DockPanel.Dock="Right" Content="올리기" Margin="2,3" Padding="10,0" Click="OnGitBarPush"
                  ToolTip="내 커밋을 원격 저장소로 보냅니다" />
          <Button DockPanel.Dock="Right" Content="받기" Margin="2,3" Padding="10,0" Click="OnGitBarPull"
                  ToolTip="원격 저장소의 새 커밋을 내 브랜치에 합칩니다" />
        </DockPanel>
      </Border>
    </Border>

    <!-- 관리 방식 바: 가장 가까운 .foldy.md를 따른다 (Git 바가 없을 때만) -->
    <Border x:Name="ManagedBar" Margin="8,0,8,6" Padding="10,0,4,0" Height="30" CornerRadius="{DynamicResource Radius}" Visibility="Collapsed"
            Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" x:Name="ManagedBarButton" Content="정리할 것 보기" Margin="2,3" Padding="10,0" Click="OnManagedBarOpen" />
        <Button DockPanel.Dock="Right" Content="방식 바꾸기" Margin="2,3" Padding="10,0" Click="OnManagedBarSettings" />
        <TextBlock Text="&#xE74C;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock x:Name="ManagedBarText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 작업 태그 진행: "20개 중 작업 완료 7 · 반영 완료 3" + [다음 파일] -->
    <Border x:Name="TagBar" Margin="8,0,8,6" Padding="10,0,4,0" Height="30" CornerRadius="{DynamicResource Radius}" Visibility="Collapsed"
            Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <ToggleButton DockPanel.Dock="Right" x:Name="TagShareToggle" Content="저장소에 공유" Margin="2,3" Padding="10,0" Visibility="Collapsed" Click="OnTagShare"
                      ToolTip="태그를 Git 저장소에 함께 올릴지 (기본 끔: 이 PC의 폴더에만)" />
        <Button DockPanel.Dock="Right" Content="태그 모두 지우기" Margin="2,3" Padding="10,0" Click="OnTagClear" ToolTip="이 폴더 파일들의 태그를 지워요 (파일은 그대로)" />
        <Button DockPanel.Dock="Right" x:Name="TagNextButton" Content="다음 파일" Margin="2,3" Padding="10,0" Click="OnTagNext" ToolTip="아직 '작업 완료'가 아닌 다음 파일로 (Ctrl+D: 작업 완료 켜고 끄기)" />
        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock x:Name="TagBarText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    </StackPanel>

    <!-- 4행: 트리 | 목록 -->
    <Grid Grid.Row="4" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TreeColumn" Width="200" MinWidth="0" MaxWidth="520" />
        <ColumnDefinition x:Name="SplitColumn" Width="10" />
        <ColumnDefinition Width="*" MinWidth="200" />
      </Grid.ColumnDefinitions>
      <!-- 미리보기(F3)는 목록 위쪽에: 목록 폭을 줄이지 않아 파일명이 잘리지 않는다 -->
      <Grid.RowDefinitions>
        <RowDefinition x:Name="PreviewRow" Height="0" MinHeight="0" />
        <RowDefinition x:Name="PreviewSplitRow" Height="0" />
        <RowDefinition Height="*" MinHeight="120" />
      </Grid.RowDefinitions>
      <Border x:Name="PreviewHost" Grid.Column="2" Grid.Row="0" Style="{DynamicResource Foldy.ListBorder}" ClipToBounds="True" Visibility="Collapsed" />
      <GridSplitter x:Name="PreviewSplitter" Grid.Column="2" Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Rows" Background="Transparent" Focusable="False" Visibility="Collapsed" />
      <Border x:Name="TreeHost" Grid.RowSpan="3" Style="{DynamicResource Foldy.ListBorder}" Padding="2,6,2,6">
        <Grid>
        <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" SelectedItemChanged="OnTreeSelected"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              <!-- 펼치기 화살표를 넉넉하게 (기본 16px은 맞추기 어렵다): 28×28, 줄 전체 높이 28 -->
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                      <Grid MinHeight="28">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Expander" Width="28" Height="28" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      AutomationProperties.Name="펼치기/접기">
                          <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                              <Border Background="Transparent">
                                <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{DynamicResource Font.Icon}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Bd" Grid.Column="1" Padding="2,0" CornerRadius="4" Background="Transparent" VerticalAlignment="Stretch">
                          <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                      <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsExpanded" Value="False">
                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                      </Trigger>
                      <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TreeView.ItemContainerStyle>
        </TreeView>
        </Grid>
      </Border>
      <GridSplitter x:Name="Splitter" Grid.Column="1" Grid.RowSpan="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />

      <Border x:Name="ContentHost" Grid.Column="2" Grid.Row="2" Style="{DynamicResource Foldy.ListBorder}" ClipToBounds="True">
        <Grid>
          <!-- 폴더 탭 -->
          <Grid x:Name="FolderLayer" AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop" DragEnter="OnListDragOver">
            <ScrollViewer x:Name="Scroller" CanContentScroll="True" Focusable="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <fc:FastFileList x:Name="List" Style="{DynamicResource Foldy.FileList}" />
            </ScrollViewer>
            <Canvas x:Name="Overlay" ClipToBounds="True" />

            <!-- 빈 폴더 / 오류 / 불러오는 중 -->
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
              <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource Font.Icon}" FontSize="32" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextDisabled}" />
              <TextBlock x:Name="EmptyText" Text="빈 폴더입니다" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <Button x:Name="EmptyExplorerButton" Content="탐색기에서 열기" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="12,4"
                      Visibility="Collapsed" Click="OnOpenInExplorer" />
            </StackPanel>
            <TextBlock x:Name="LoadingText" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="12"
                       Foreground="{DynamicResource Brush.TextSecondary}" Visibility="Collapsed" />
            <Border x:Name="ErrorBanner" VerticalAlignment="Top" Margin="12,40,12,0" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1"
                    Visibility="Collapsed">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="다시 시도" Click="OnRefresh" Margin="12,0,0,0" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
              </DockPanel>
            </Border>
          </Grid>

          <!-- 이미지만 보기 (Ctrl+Shift+I, 설계서 5.12) -->
          <ScrollViewer x:Name="ImageLayer" Visibility="Collapsed" CanContentScroll="True" Focusable="False"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />

          <!-- 문서(Markdown) 탭 -->
          <ContentControl x:Name="DocumentLayer" Visibility="Collapsed" Focusable="False" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
