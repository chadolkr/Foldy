<UserControl x:Class="Foldy.UI.Git.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gc="clr-namespace:Foldy.UI.Git"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="{DynamicResource Font.UI}"
             FontSize="{DynamicResource Font.Size}"
             Focusable="True">
  <!--
    Fork식 Git 뷰 (설계서 "Git 통합"). DataContext = Foldy.Presentation.Git.GitTabViewModel.
    색·글꼴·반경은 모두 DynamicResource 토큰 → 라이트/다크/레트로가 바로 바뀐다 (그래프 레인 색만 고정 팔레트).
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- 툴바 텍스트 버튼 -->
    <Style x:Key="Git.Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius}"
                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 강조 버튼 (Commit) -->
    <Style x:Key="Git.PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Git.Btn}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius}"
                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 보조 버튼 (목록 머리의 Stage / Unstage) -->
    <Style x:Key="Git.SmallBtn" TargetType="Button" BasedOn="{StaticResource Git.Btn}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Git.SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="12,14,0,4" />
    </Style>

    <Style x:Key="Git.Divider" TargetType="Rectangle">
      <Setter Property="Fill" Value="{DynamicResource Brush.Border}" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="4,6" />
    </Style>

    <!-- 목록 항목: 테두리 없는 평평한 행 -->
    <Style x:Key="Git.Item" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Git.BranchItem" TargetType="ListBoxItem" BasedOn="{StaticResource Git.Item}">
      <EventSetter Event="MouseDoubleClick" Handler="OnBranchDoubleClick" />
    </Style>

    <Style x:Key="Git.List" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource Git.Item}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- M/A/D/R/?/! 배지 글자 -->
    <Style x:Key="Git.Letter" TargetType="TextBlock">
      <Setter Property="Width" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="A">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Done}" />
        </Trigger>
        <Trigger Property="Text" Value="?">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Done}" />
        </Trigger>
        <Trigger Property="Text" Value="D">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
        </Trigger>
        <Trigger Property="Text" Value="!">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
        </Trigger>
        <Trigger Property="Text" Value="R">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Git.Graph" TargetType="gc:CommitGraphList">
      <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="SecondaryForeground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection}" />
      <Setter Property="SelectionForeground" Value="{DynamicResource Brush.SelectionText}" />
      <Setter Property="HoverBrush" Value="{DynamicResource Brush.Hover}" />
      <Setter Property="AccentBrush" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="AccentForeground" Value="{DynamicResource Brush.AccentText}" />
      <Setter Property="TagBrush" Value="{DynamicResource Brush.Done}" />
      <Setter Property="FocusBrush" Value="{DynamicResource Brush.Focus}" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size}" />
      <Setter Property="RowHeight" Value="{DynamicResource List.RowHeight}" />
    </Style>

    <!-- 파일 한 줄 (Local Changes / 커밋 변경 파일 공용): 배지 + 파일명 + 폴더 -->
    <DataTemplate x:Key="Git.FileRow">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Letter}" Style="{StaticResource Git.Letter}" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Folder}" Foreground="{DynamicResource Brush.TextSecondary}"
                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0" MaxWidth="260" VerticalAlignment="Center" />
        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ───────── 툴바 ───────── -->
    <Border Grid.Row="0" Style="{DynamicResource Foldy.CommandBar}">
      <StackPanel Orientation="Horizontal">
        <!-- 현재 브랜치 칩 -->
        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius}" Padding="10,0" Height="28" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE8A1;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,1,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BranchName}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AheadBehindText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Style="{StaticResource Git.Btn}" Content="Fetch" Command="{Binding FetchCommand}" IsEnabled="{Binding IsIdle}" ToolTip="모든 원격에서 가져오기 (--all --prune)" />
        <Button x:Name="PullBtn" Style="{StaticResource Git.Btn}" Content="Pull ▾" Click="OnPullMenu" IsEnabled="{Binding IsIdle}" ToolTip="Pull (병합 또는 리베이스)" />
        <Button Style="{StaticResource Git.Btn}" Content="Push" Command="{Binding PushCommand}" IsEnabled="{Binding IsIdle}" ToolTip="Push (업스트림이 없으면 origin에 새로 만듦)" Margin="1,0,0,0" />
        <Button x:Name="PushMoreBtn" Style="{StaticResource Git.Btn}" Content="▾" Padding="4,0" Click="OnPushMenu" IsEnabled="{Binding IsIdle}" Margin="0,0,1,0" ToolTip="강제 Push 등" />
        <Rectangle Style="{StaticResource Git.Divider}" />
        <Button x:Name="StashBtn" Style="{StaticResource Git.Btn}" Content="Stash ▾" Click="OnStashMenu" IsEnabled="{Binding IsIdle}" />
        <Button x:Name="BranchBtn" Style="{StaticResource Git.Btn}" Content="Branch ▾" Click="OnBranchMenu" IsEnabled="{Binding IsIdle}" />
        <Rectangle Style="{StaticResource Git.Divider}" />
        <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="새로 고침" Height="28" Width="28" />

        <!-- 팝업 메뉴들 (툴바 버튼 아래에 열림) -->
        <Popup x:Name="PullPopup" PlacementTarget="{Binding ElementName=PullBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius}" Padding="4" Margin="0,2,8,8">
            <StackPanel MinWidth="170">
              <Button Style="{StaticResource Git.Btn}" HorizontalContentAlignment="Left" Content="Pull (merge)" Command="{Binding PullMergeCommand}" Click="OnClosePopups" />
              <Button Style="{StaticResource Git.Btn}" Content="Pull (rebase)" Command="{Binding PullRebaseCommand}" Click="OnClosePopups" />
            </StackPanel>
          </Border>
        </Popup>
        <Popup x:Name="PushPopup" PlacementTarget="{Binding ElementName=PushMoreBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius}" Padding="4" Margin="0,2,8,8">
            <StackPanel MinWidth="230">
              <Button Style="{StaticResource Git.Btn}" Content="강제 Push (--force-with-lease)…" Command="{Binding PushForceWithLeaseCommand}" Click="OnClosePopups" />
            </StackPanel>
          </Border>
        </Popup>
        <Popup x:Name="StashPopup" PlacementTarget="{Binding ElementName=StashBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius}" Padding="4" Margin="0,2,8,8">
            <StackPanel MinWidth="190">
              <Button Style="{StaticResource Git.Btn}" Content="변경을 Stash에 넣기" Command="{Binding StashPushCommand}" Click="OnClosePopups" />
              <Button Style="{StaticResource Git.Btn}" Content="Stash 꺼내기 (pop)" Command="{Binding StashPopCommand}" Click="OnClosePopups"
                      ToolTip="사이드바에서 고른 Stash, 없으면 가장 최근 것" />
            </StackPanel>
          </Border>
        </Popup>
        <Popup x:Name="BranchPopup" PlacementTarget="{Binding ElementName=BranchBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius}" Padding="4" Margin="0,2,8,8">
            <StackPanel MinWidth="240">
              <ListBox ItemsSource="{Binding LocalBranches}" Style="{StaticResource Git.List}" MaxHeight="260"
                       ItemContainerStyle="{StaticResource Git.BranchItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Track}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="12,0,0,0" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Rectangle Height="1" Fill="{DynamicResource Brush.Border}" Margin="4,6" />
              <Grid Margin="4,0,4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource Foldy.InputBorder}" Height="28">
                  <Grid>
                    <TextBlock Text="새 브랜치 이름" Foreground="{DynamicResource Brush.TextDisabled}" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=NewBranchBox}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="NewBranchBox" Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNewBranchKey" />
                  </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource Git.Btn}" Content="만들기" Margin="6,0,0,0" Command="{Binding CreateBranchCommand}" Click="OnClosePopups" />
              </Grid>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </Border>

    <!-- ───────── 본문 ───────── -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="150" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- 사이드바 -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,0,12">
            <Button Style="{StaticResource Git.Btn}" Height="32" Margin="6,2" HorizontalContentAlignment="Stretch" Command="{Binding SelectLocalChangesCommand}">
              <DockPanel LastChildFill="True" Width="190">
                <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Accent}" CornerRadius="9" MinWidth="20" Padding="6,1" VerticalAlignment="Center"
                        Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                  <TextBlock Text="{Binding ChangeCount}" Foreground="{DynamicResource Brush.AccentText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Local Changes" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" />
              </DockPanel>
            </Button>

            <TextBlock Text="BRANCHES" Style="{StaticResource Git.SectionHeader}" />
            <ListBox ItemsSource="{Binding LocalBranches}" Style="{StaticResource Git.List}" ItemContainerStyle="{StaticResource Git.BranchItem}"
                     ToolTip="더블클릭: 체크아웃">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Track}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="REMOTES" Style="{StaticResource Git.SectionHeader}" />
            <ListBox ItemsSource="{Binding RemoteBranches}" Style="{StaticResource Git.List}" ItemContainerStyle="{StaticResource Git.BranchItem}"
                     ToolTip="더블클릭: 추적 브랜치로 체크아웃">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="STASHES" Style="{StaticResource Git.SectionHeader}" />
            <ListBox ItemsSource="{Binding Stashes}" SelectedItem="{Binding SelectedStash, Mode=TwoWay}" Style="{StaticResource Git.List}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False" />

      <!-- 가운데: 검색 + 그래프 + 아래 칸 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="300" MinHeight="140" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Foldy.InputBorder}" Margin="0,8,8,6">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock Text="커밋 검색 (메시지·작성자·해시)" Foreground="{DynamicResource Brush.TextDisabled}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="SearchBox" Padding="28,0,6,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource Foldy.ListBorder}" Margin="0,0,8,0" ClipToBounds="True">
          <ScrollViewer x:Name="GraphScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
            <gc:CommitGraphList x:Name="Graph" Style="{StaticResource Git.Graph}"
                                ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                                ShowGraph="{Binding ShowGraph}" MaxLanes="{Binding MaxLaneCount}"
                                ReachedEnd="OnGraphReachedEnd" />
          </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ShowsPreview="False" Margin="0,0,8,0" />

        <!-- 아래 칸: Local Changes 또는 선택한 커밋 -->
        <Grid Grid.Row="3" Margin="0,0,8,8">
          <!-- Local Changes -->
          <Grid Visibility="{Binding ShowLocalChanges, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource Foldy.ListBorder}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,4,6,2" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Unstaged.Count, StringFormat=Unstaged ({0})}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Git.SmallBtn}" Content="모두 Stage" Command="{Binding StageAllCommand}" IsEnabled="{Binding IsIdle}" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Git.SmallBtn}" Content="Stage ▸" Command="{Binding StageSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip="선택한 파일을 Stage (선택이 없으면 전체)" />
                </DockPanel>
                <ListBox x:Name="UnstagedList" Style="{StaticResource Git.List}" ItemsSource="{Binding Unstaged}" ItemTemplate="{StaticResource Git.FileRow}"
                         SelectionMode="Extended" SelectionChanged="OnUnstagedSelection" MouseDoubleClick="OnUnstagedDoubleClick" />
              </DockPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource Foldy.ListBorder}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,4,6,2" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Staged.Count, StringFormat=Staged ({0})}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Git.SmallBtn}" Content="모두 Unstage" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding IsIdle}" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Git.SmallBtn}" Content="◂ Unstage" Command="{Binding UnstageSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip="선택한 파일을 Unstage (선택이 없으면 전체)" />
                </DockPanel>
                <ListBox x:Name="StagedList" Style="{StaticResource Git.List}" ItemsSource="{Binding Staged}" ItemTemplate="{StaticResource Git.FileRow}"
                         SelectionMode="Extended" SelectionChanged="OnStagedSelection" MouseDoubleClick="OnStagedDoubleClick" />
              </DockPanel>
            </Border>

            <!-- 커밋 메시지 + 버튼 -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{DynamicResource Foldy.InputBorder}" Height="76">
                <Grid>
                  <TextBlock Text="커밋 메시지" Foreground="{DynamicResource Brush.TextDisabled}" Margin="10,8" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=CommitBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBox x:Name="CommitBox" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" MinWidth="130">
                <Button Style="{StaticResource Git.PrimaryBtn}" Content="Commit" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" />
                <Button Style="{StaticResource Git.Btn}" Content="Commit &amp; Push" Command="{Binding CommitAndPushCommand}" IsEnabled="{Binding CanCommit}"
                        Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,0,6" />
                <CheckBox Content="Amend" IsChecked="{Binding Amend}" Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"
                          ToolTip="직전 커밋을 고칩니다 (메시지가 비어 있으면 그대로 유지)" />
              </StackPanel>
            </Grid>
          </Grid>

          <!-- 선택한 커밋 -->
          <Border Style="{DynamicResource Foldy.ListBorder}" Visibility="{Binding ShowCommitDetails, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="12,8,12,6" DataContext="{Binding SelectedCommit}">
                <TextBlock Text="{Binding Node.Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0">
                  <Run Text="{Binding Node.ShortHash, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" />
                  <Run Text="·" />
                  <Run Text="{Binding Node.AuthorName, Mode=OneWay}" />
                  <Run Text="·" />
                  <Run Text="{Binding DateText, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
              <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Brush.Border}" />
              <ListBox Style="{StaticResource Git.List}" ItemsSource="{Binding CommitFiles}" ItemTemplate="{StaticResource Git.FileRow}" Margin="0,4,0,0" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ───────── 상태 줄: 진행 · 오류 ───────── -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}">
      <StackPanel>
        <ProgressBar Height="2" IsIndeterminate="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Progress}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Padding="12,6">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Git.Btn}" Content="이 저장소 신뢰하기" Command="{Binding TrustRepositoryCommand}" Margin="12,0,0,0"
                    Visibility="{Binding CanTrustRepo, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource Foldy.StatusText}" Height="24" Padding="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
