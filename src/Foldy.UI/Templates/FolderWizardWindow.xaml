<Window x:Class="Foldy.UI.Templates.FolderWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Foldy.UI.Localization"
        xmlns:t="clr-namespace:Foldy.UI.Templates"
        Title="{loc:T wiz.title}" Width="980" Height="660" MinWidth="780" MinHeight="520"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{DynamicResource Foldy.Window}"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        t:DialogCloser.Result="{Binding DialogResult}">
  <!-- DataContext = Foldy.Presentation.Templates.FolderWizardViewModel -->
  <Window.Resources>
    <ResourceDictionary Source="pack://application:,,,/Foldy.UI;component/Templates/TemplateResources.xaml" />
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 왼쪽 단계 목록 -->
    <Border Grid.RowSpan="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="18,22,12,18">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:T wiz.title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" Background="Transparent">
                  <Grid>
                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock x:Name="Chk" Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="11" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}" />
                  </Grid>
                </Border>
                <TextBlock x:Name="Ttl" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Chk" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Ttl" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Ttl" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                  <Setter TargetName="Ttl" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- 오른쪽 단계 내용 -->
    <Grid Grid.Column="1" Margin="28,22,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Tpl.Title}" Margin="0,0,0,14" />

      <!-- 1. 용도 -->
      <DockPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Purpose}">
        <TextBlock DockPanel.Dock="Top" Text="{Binding PurposeQuestion}" FontSize="14" Margin="0,0,0,12" />
        <Button DockPanel.Dock="Bottom" Style="{StaticResource Tpl.LinkButton}" Command="{Binding PickTemplateDirectlyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
          <TextBlock Text="{loc:T wiz.knowTemplate}" />
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Purposes}" Focusable="False" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource Tpl.ChoiceCard}" GroupName="purpose" IsChecked="{Binding IsSelected}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Tpl.Secondary}" Margin="0,4,0,0" FontSize="11.5" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- 2. 질문 -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Questions}">
        <ItemsControl ItemsSource="{Binding Questions}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Tpl.Secondary}" Visibility="{Binding Hint, Converter={StaticResource BoolVis}}" Margin="0,2,0,0" />
                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,8,0,0" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton Style="{StaticResource Tpl.ChoiceCard}" IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 3. 추천과 설명 (나란히 비교) -->
      <DockPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Recommend}">
        <CheckBox DockPanel.Dock="Top" Content="{loc:T wiz.showAll}" IsChecked="{Binding ShowAll}" Margin="0,0,0,10" />
        <ListBox ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedRecommendation}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource Tpl.CardItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                    <Border Style="{StaticResource Tpl.Badge}" Margin="8,0,0,0" Background="{DynamicResource Brush.Accent}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}">
                      <TextBlock Text="{loc:T wiz.recommended}" FontSize="10.5" Foreground="{DynamicResource Brush.AccentText}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding GuideSummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding ReasonText}" Style="{StaticResource Tpl.Secondary}" Margin="0,6,0,0" Visibility="{Binding ReasonText, Converter={StaticResource BoolVis}}" />
                  <TextBlock Text="{loc:T wiz.exampleTree}" Style="{StaticResource Tpl.Section}" />
                  <Border Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="10,8">
                    <TextBlock Text="{Binding ExampleTree}" FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" />
                  </Border>
                  <TextBlock Text="{loc:T wiz.naming}" Style="{StaticResource Tpl.Section}" />
                  <TextBlock Text="{Binding NamingSummary}" TextWrapping="Wrap" FontSize="11.5" />
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- 4. 내 상황에 맞추기 -->
      <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Customize}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="270" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
          <StackPanel>
            <TextBlock Text="{Binding Customizer.Template.Name}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{loc:T wiz.uncheck}" Style="{StaticResource Tpl.Secondary}" Margin="0,4,0,8" />
            <ContentControl Content="{Binding Customizer}" ContentTemplate="{StaticResource Tpl.CustomizerInputs}" Focusable="False" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Style="{StaticResource Tpl.Card}">
          <ContentControl Content="{Binding Customizer}" ContentTemplate="{StaticResource Tpl.PreviewTree}" Focusable="False" />
        </Border>
      </Grid>

      <!-- 5. 확인 -->
      <StackPanel Grid.Row="1" MaxWidth="560" HorizontalAlignment="Left" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Confirm}">
        <TextBlock Text="{loc:T wiz.location}" Style="{StaticResource Tpl.Section}" Margin="0,0,0,6" />
        <TextBox Style="{StaticResource Tpl.Input}" Text="{Binding Customizer.TargetFolder, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
        <TextBlock Text="{Binding Customizer.Summary}" Style="{StaticResource Tpl.Secondary}" Margin="0,6,0,10" />
        <CheckBox Content="{loc:T wiz.writeGuide}" IsChecked="{Binding WriteDescription}" />
        <CheckBox Content="{loc:T wiz.namingHint}" IsChecked="{Binding EnableNamingHints}" />
        <CheckBox Content="{loc:T wiz.saveTemplate}" IsChecked="{Binding SaveAsMyTemplate}" />
        <TextBlock Text="{loc:T wiz.noOverwrite}"
                   Style="{StaticResource Tpl.Secondary}" Margin="0,14,0,0" />
      </StackPanel>

      <!-- 6. 완료 -->
      <StackPanel Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Done}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
          <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="20" Foreground="{DynamicResource Brush.AccentText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:T wiz.done}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Result.TopFolder}" Style="{StaticResource Tpl.Secondary}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{loc:T wiz.startLike}" Style="{StaticResource Tpl.Section}" />
        <ItemsControl ItemsSource="{Binding FirstSteps}" Focusable="False" AlternationCount="10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Tpl.Card}" Margin="0,0,0,8" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Tpl.Icon}" Text="&#xE76C;" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding SavedTemplatePath, StringFormat={loc:T tpl.savedAs}}" Style="{StaticResource Tpl.Secondary}"
                   Visibility="{Binding SavedTemplatePath, Converter={StaticResource BoolVis}}" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <!-- 아래 버튼 -->
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="28,12,24,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{loc:T wiz.prev}" Command="{Binding BackCommand}" MinWidth="80" Margin="0,0,8,0" />
        <Button Content="{Binding NextLabel}" Style="{StaticResource Tpl.Primary}" IsDefault="True" Command="{Binding NextCommand}" MinWidth="96" Margin="0,0,8,0" />
        <Button Content="{loc:T shell.cancel}" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="80" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Error}" Style="{StaticResource Tpl.Error}" />
        <TextBlock Text="{Binding Customizer.ProblemText}" Style="{StaticResource Tpl.Error}"
                   Visibility="{Binding CurrentStep, Converter={StaticResource EnumVis}, ConverterParameter=Customize}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
