<Window x:Class="Foldy.UI.Templates.OrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Foldy.UI.Localization"
        xmlns:t="clr-namespace:Foldy.UI.Templates"
        Title="{loc:T org.title}" Width="1120" Height="720" MinWidth="860" MinHeight="540"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{DynamicResource Foldy.Window}"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        t:DialogCloser.Result="{Binding DialogResult}">
  <!-- DataContext = Foldy.Presentation.Templates.OrganizeViewModel -->
  <Window.Resources>
    <ResourceDictionary Source="pack://application:,,,/Foldy.UI;component/Templates/TemplateResources.xaml" />
  </Window.Resources>
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 1) 대상 + 방식 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{loc:T org.folder}" Style="{StaticResource Tpl.Section}" Margin="0,0,0,4" />
        <TextBox Style="{StaticResource Tpl.Input}" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="150">
        <TextBlock Text="{loc:T org.mode}" Style="{StaticResource Tpl.Section}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" MinHeight="30" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="12,0,0,0" Width="190" Visibility="{Binding IsTemplateMode, Converter={StaticResource BoolVis}}">
        <TextBlock Text="{loc:T org.style}" Style="{StaticResource Tpl.Section}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" MinHeight="30" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="12,0,0,0" Width="150" Visibility="{Binding IsDateMode, Converter={StaticResource BoolVis}}">
        <TextBlock Text="{loc:T org.dateFormat}" Style="{StaticResource Tpl.Section}" Margin="0,0,0,4" />
        <TextBox Style="{StaticResource Tpl.Input}" Text="{Binding DateFormat}" />
      </StackPanel>
      <Button Grid.Column="3" Content="{loc:T org.plan}" Command="{Binding PlanCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0" MinWidth="104" MinHeight="30" />
    </Grid>

    <!-- 2) 옵션 + 직접 규칙 -->
    <StackPanel Grid.Row="1" Margin="0,8,0,0">
      <TextBlock Text="{Binding SelectedMode.Description}" Style="{StaticResource Tpl.Secondary}" Margin="0,0,0,6" />
      <WrapPanel>
        <CheckBox Content="{loc:T org.recursive}" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,18,0" />
        <CheckBox Content="{loc:T org.dups}" IsChecked="{Binding DetectDuplicates}" Margin="0,0,18,0" />
        <CheckBox Content="{loc:T org.datePrefix}" IsChecked="{Binding PrefixDate}" Margin="0,0,18,0" />
      </WrapPanel>
      <Border Style="{StaticResource Tpl.Card}" Margin="0,10,0,0" Padding="12,10" Visibility="{Binding IsCustomMode, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T org.rule.pattern}" Style="{StaticResource Tpl.Secondary}" />
            <TextBlock Grid.Column="1" Text="{loc:T org.rule.keywords}" Style="{StaticResource Tpl.Secondary}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="{loc:T org.rule.target}" Style="{StaticResource Tpl.Secondary}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="{loc:T org.rule.folders}" Style="{StaticResource Tpl.Secondary}" Margin="8,0,0,0" />
          </Grid>
          <ItemsControl ItemsSource="{Binding CustomRules}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource Tpl.Input}" Text="{Binding Pattern}" />
                  <TextBox Grid.Column="1" Style="{StaticResource Tpl.Input}" Text="{Binding Keywords}" Margin="8,0,0,0" />
                  <TextBox Grid.Column="2" Style="{StaticResource Tpl.Input}" Text="{Binding Target}" Margin="8,0,0,0" />
                  <CheckBox Grid.Column="3" IsChecked="{Binding ApplyToFolders}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <Button Grid.Column="4" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE711;" ToolTip="{loc:T org.rule.delete}"
                          Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Tpl.LinkButton}" Command="{Binding AddRuleCommand}" HorizontalAlignment="Left">
            <TextBlock Text="{loc:T org.rule.add}" />
          </Button>
        </StackPanel>
      </Border>
      <!-- 큰 폴더: 오래 걸리면 뒤에서 만들고 끝나면 알려 주기 (사용자 2026-11-23) -->
      <Border x:Name="BackgroundOffer" Style="{StaticResource Tpl.Card}" Margin="0,10,0,0" Padding="12,10"
              Visibility="{Binding ShowBackgroundOffer, Converter={StaticResource BoolVis}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RunInBackgroundButton" Content="{loc:T org.bg.run}" Style="{StaticResource Tpl.Primary}" Command="{Binding RunInBackgroundCommand}"
                    MinWidth="110" Margin="12,0,8,0" AutomationProperties.AutomationId="OrganizeRunInBackground" />
            <Button Content="{loc:T org.bg.wait}" Command="{Binding KeepWaitingCommand}" MinWidth="110" AutomationProperties.AutomationId="OrganizeKeepWaiting" />
          </StackPanel>
          <TextBlock Style="{StaticResource Tpl.Icon}" Text="&#xE916;" FontSize="18" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{loc:T org.bg.offer}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{loc:T org.bg.offerTip}" Style="{StaticResource Tpl.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- 3) 미리보기: 지금 ↔ 정리 후, 아래에 이동 목록 -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" />
        <RowDefinition Height="3*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Tpl.Card}" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T org.now}" Style="{StaticResource Tpl.Section}" Margin="2,0,0,6" />
            <TreeView ItemsSource="{Binding BeforeTree}" ItemTemplate="{StaticResource Tpl.OrganizeNode}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
          </DockPanel>
        </Border>
        <TextBlock Grid.Column="1" Style="{StaticResource Tpl.Icon}" Text="&#xE72A;" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
        <Border Grid.Column="2" Style="{StaticResource Tpl.Card}" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T org.after}" Style="{StaticResource Tpl.Section}" Margin="2,0,0,6" />
            <TreeView ItemsSource="{Binding AfterTree}" ItemTemplate="{StaticResource Tpl.OrganizeNode}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
          </DockPanel>
        </Border>
      </Grid>

      <TabControl Grid.Row="1" Style="{StaticResource Tpl.Tabs}" Margin="0,10,0,0" SelectedIndex="{Binding SelectedListTab}">
        <TabItem Header="{loc:T org.moves}">
          <ListView ItemsSource="{Binding Moves}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="36">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsIncluded}" Margin="0" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{loc:T org.col.from}" Width="260" DisplayMemberBinding="{Binding SourceRelative}" />
                <GridViewColumn Header="{loc:T org.col.to}" Width="180">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Style="{StaticResource Tpl.Input}" MinHeight="24" Padding="4,1" Text="{Binding TargetFolder, UpdateSourceTrigger=LostFocus}" Width="164" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{loc:T org.col.newName}" Width="200" DisplayMemberBinding="{Binding DestinationName}" />
                <GridViewColumn Header="{loc:T org.col.reason}" Width="300" DisplayMemberBinding="{Binding Reason}" />
              </GridView>
            </ListView.View>
          </ListView>
        </TabItem>
        <TabItem Header="{loc:T org.skipped}">
          <ListView ItemsSource="{Binding Skipped}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{loc:T org.col.path}" Width="520" DisplayMemberBinding="{Binding FullPath}" />
                <GridViewColumn Header="{loc:T org.col.reason}" Width="380" DisplayMemberBinding="{Binding Reason}" />
              </GridView>
            </ListView.View>
          </ListView>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- 4) 상태 + 버튼 -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{loc:T org.run}" Style="{StaticResource Tpl.Primary}" IsDefault="True" Command="{Binding ExecuteCommand}" MinWidth="96" Margin="0,0,8,0" />
        <Button Content="{loc:T org.undo}" Command="{Binding UndoCommand}" MinWidth="90" Margin="0,0,8,0" />
        <Button Content="{loc:T shell.close}" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="80" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
        <!-- 정리할 수 없거나 옮길 것이 없을 때 이유가 잘 보이게 (오류면 굵은 빨간 글씨) -->
        <TextBlock Text="{Binding ScanInfo}" Style="{StaticResource Tpl.Secondary}" TextWrapping="Wrap" MaxWidth="600" AutomationProperties.AutomationId="OrganizeScanInfo" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="600">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Tpl.Secondary}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Error">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
