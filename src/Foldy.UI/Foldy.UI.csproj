<Project Sdk="Microsoft.NET.Sdk">
  <!-- 화면(XAML), 컨트롤, 테마. WPF를 참조하는 프로젝트는 Foldy.App과 Foldy.UI 둘뿐이다 (설계서 4장). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Foldy.UI</RootNamespace>
    <!-- CA1001: 앱 수명 동안 사는 UI 서비스(아이콘 큐 등) -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Foldy.Platform\Foldy.Platform.csproj" />
    <ProjectReference Include="..\Foldy.Presentation\Foldy.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icons\png\foldy-16.png" Link="Assets\foldy-16.png" />
    <Resource Include="..\..\assets\icons\png\foldy-32.png" Link="Assets\foldy-32.png" />
    <Resource Include="..\..\assets\icons\foldy.ico" Link="Assets\foldy.ico" />
  </ItemGroup>
</Project>
