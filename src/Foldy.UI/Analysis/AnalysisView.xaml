<UserControl x:Class="Foldy.UI.Analysis.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Foldy.UI.Localization"
             xmlns:an="clr-namespace:Foldy.UI.Analysis"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="{DynamicResource Font.UI}"
             FontSize="{DynamicResource Font.Size}"
             Focusable="True">
  <!--
    폴더 분석 탭 (설계서 7.3). DataContext = Foldy.Presentation.Analysis.AnalysisTabViewModel.
    색·글꼴·반경은 모두 DynamicResource 테마 토큰이다. 트리맵 칸 색도 Brush.Tab0~7 토큰 (TreemapControl).
    [휴지통으로]는 ViewModel이 RecycleRequested 이벤트를 올릴 뿐 이 화면도 ViewModel도 아무것도 지우지 않는다.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <an:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <an:NotConverter x:Key="Not" />
    <an:LocalDateConverter x:Key="LocalDate" />

    <Style x:Key="An.Btn" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius}"
                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="An.Button" TargetType="Button" BasedOn="{StaticResource An.Btn}" />
    <Style x:Key="An.Toggle" TargetType="ToggleButton" BasedOn="{StaticResource An.Btn}">
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionText}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="An.Primary" TargetType="Button" BasedOn="{StaticResource An.Btn}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 브레드크럼 -->
    <Style x:Key="An.Crumb" TargetType="Button" BasedOn="{StaticResource An.Btn}">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Height" Value="24" />
    </Style>

    <Style x:Key="An.Item" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="An.List" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource An.Item}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="An.Path" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="An.Size" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="An.Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style x:Key="An.Tag" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,4,4,0">
                <WrapPanel IsItemsHost="True" />
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Padding="10,5" Margin="0,0,2,0" CornerRadius="4,4,0,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="An.Progress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Progress}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="TemplateRoot">
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 폴더 목록 행 (큰 폴더, 파일 많은 폴더) -->
    <DataTemplate x:Key="An.FolderRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Row.Name}" Style="{StaticResource An.Path}" FontWeight="SemiBold" />
            <Border Style="{StaticResource An.Tag}" Visibility="{Binding Tag, Converter={StaticResource NullToCollapsed}}">
              <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Path}" Style="{StaticResource An.Sub}" ToolTip="{Binding Path}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding FilesText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource An.Size}" MinWidth="64" TextAlignment="Right" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="An.FileRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Name}" Style="{StaticResource An.Path}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Path}" Style="{StaticResource An.Sub}" ToolTip="{Binding Path}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource An.Size}" MinWidth="64" TextAlignment="Right" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="An.ExtRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="168" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource An.Sub}">
            <Run Text="{Binding FilesText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <Border Grid.Column="1" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                Width="{Binding BarWidth}" Background="{DynamicResource Brush.Accent}" Margin="8,0" />
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource An.Size}" MinWidth="64" TextAlignment="Right" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 도구 줄 -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,5">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Style="{StaticResource An.Primary}" Content="{loc:T an.reanalyze}" Command="{Binding AnalyzeCommand}"
                ToolTip="{loc:T an.reanalyze.tip}" />
        <Button DockPanel.Dock="Left" Style="{StaticResource An.Button}" Content="{loc:T shell.cancel}" Command="{Binding CancelCommand}" Margin="4,0,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource An.Button}" Content="{loc:T shell.tidy.downloads}" Command="{Binding OpenToolCommand}" CommandParameter="downloads" Margin="4,0,0,0"
                ToolTip="{loc:T an.downloads.tip}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource An.Button}" Content="{loc:T an.rebuildable}" Command="{Binding OpenToolCommand}" CommandParameter="rebuildable" Margin="4,0,0,0"
                ToolTip="{loc:T an.rebuildable.tip}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource An.Button}" Content="{loc:T shell.tidy.logs}" Command="{Binding OpenToolCommand}" CommandParameter="logs" Margin="12,0,0,0"
                ToolTip="{loc:T an.logs.tip}" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock Text="{Binding ScanText}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1">
      <ProgressBar Style="{StaticResource An.Progress}" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
      <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Padding="10,6" BorderBrush="{DynamicResource Brush.Error}" BorderThickness="0,0,0,1">
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- 본문 -->
    <Grid Grid.Row="2" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="240" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="2*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- 트리맵 + 브레드크럼 -->
      <DockPanel Grid.Column="0" Margin="8,6,0,8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Left" Style="{StaticResource An.Crumb}" Command="{Binding UpCommand}" ToolTip="{loc:T an.up.tip}" AutomationProperties.Name="{loc:T shell.moveUp}"
                  FontFamily="{DynamicResource Font.Icon}" Content="&#xE74A;" />
          <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="›" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="2,0" />
                  <Button Style="{StaticResource An.Crumb}" Content="{Binding Name}"
                          Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CurrentFolderText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius}" ClipToBounds="True">
          <an:TreemapControl ItemsSource="{Binding TreemapItems}" DrillDownCommand="{Binding DrillDownCommand}" UpCommand="{Binding UpCommand}" />
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- 목록 -->
      <TabControl Grid.Column="2" Margin="0,4,8,8">
        <TabItem Header="{loc:T an.suggest}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ReclaimText}" Margin="12,8,12,4" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" Margin="12,0,12,6" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                       Text="{loc:T an.suggest.hint}" />
            <TextBlock DockPanel.Dock="Top" Margin="12,0,12,6" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap">
              <Run Text="{loc:T an.system.hint}" />
              <Hyperlink Click="OnOpenWindowsCleanup" ToolTip="{loc:T an.system.link}">Windows 정리 권장 사항 열기</Hyperlink>
            </TextBlock>
            <ListBox ItemsSource="{Binding Candidates}" Style="{StaticResource An.List}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Path}" Style="{StaticResource An.Sub}" ToolTip="{Binding Path}" />
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource An.Sub}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource An.Size}" />
                    <Button Grid.Column="2" Style="{StaticResource An.Button}" Content="{loc:T an.recycle}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DataContext.RecycleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" IsEnabled="{Binding IsPending, Converter={StaticResource Not}}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:T an.bigFolders}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6">
              <ToggleButton Style="{StaticResource An.Toggle}" Content="{loc:T an.ownSize}" IsChecked="{Binding OwnSizeOnly}"
                            ToolTip="{loc:T an.ownSize.tip}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding TopFolders}" Style="{StaticResource An.List}" ItemTemplate="{StaticResource An.FolderRow}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:T an.bigFiles}">
          <ListBox ItemsSource="{Binding TopFiles}" Style="{StaticResource An.List}" ItemTemplate="{StaticResource An.FileRow}" />
        </TabItem>

        <TabItem Header="{loc:T an.manyFiles}">
          <ListBox ItemsSource="{Binding MostFilesFolders}" Style="{StaticResource An.List}" ItemTemplate="{StaticResource An.FolderRow}" />
        </TabItem>

        <TabItem Header="{loc:T an.kinds}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T an.byKind}" FontWeight="SemiBold" Margin="12,8,12,2" />
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Groups}" Style="{StaticResource An.List}" ItemTemplate="{StaticResource An.ExtRow}" MaxHeight="300" />
            <TextBlock DockPanel.Dock="Top" Text="{loc:T an.byExt}" FontWeight="SemiBold" Margin="12,8,12,2" />
            <ListBox ItemsSource="{Binding Extensions}" Style="{StaticResource An.List}" ItemTemplate="{StaticResource An.ExtRow}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:T an.oldFiles}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6">
              <TextBlock Text="{loc:T an.modifiedAgo}" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource Brush.TextSecondary}" />
              <Button Style="{StaticResource An.Button}" Content="{loc:T an.y1}" Command="{Binding SetOldFileYearsCommand}" CommandParameter="1" />
              <Button Style="{StaticResource An.Button}" Content="{loc:T an.y2}" Command="{Binding SetOldFileYearsCommand}" CommandParameter="2" />
              <Button Style="{StaticResource An.Button}" Content="{loc:T an.y5}" Command="{Binding SetOldFileYearsCommand}" CommandParameter="5" />
              <TextBlock VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource Brush.TextSecondary}">
                <Run Text="{Binding OldFileYears, Mode=OneWay}" /><Run Text="{loc:T an.oldSuffix}" />
              </TextBlock>
            </StackPanel>
            <ListBox ItemsSource="{Binding OldFiles}" Style="{StaticResource An.List}" ItemTemplate="{StaticResource An.FileRow}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:T an.growth}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding GrowthText}" Margin="12,8,12,4" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PreviousSnapshots}" Margin="8,0,8,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource An.Button}" Content="{Binding ScanTimeUtc, Converter={StaticResource LocalDate}}"
                          Command="{Binding DataContext.SelectPreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" ToolTip="{loc:T an.compare}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListBox ItemsSource="{Binding Growth}" Style="{StaticResource An.List}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" />
                        <Border Style="{StaticResource An.Tag}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{loc:T an.newFolder}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource An.Sub}" ToolTip="{Binding Path}" />
                      <TextBlock Text="{Binding SizeText}" Style="{StaticResource An.Sub}" />
                    </StackPanel>
                    <TextBlock x:Name="Delta" Grid.Column="1" Text="{Binding DeltaText}" Style="{StaticResource An.Size}" Foreground="{DynamicResource Brush.Done}" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Grew}" Value="True">
                      <Setter TargetName="Delta" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- 분석 결과가 없을 때 -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{loc:T an.none}" HorizontalAlignment="Center" FontSize="15" Margin="0,0,0,10" />
      <Button Style="{StaticResource An.Primary}" Content="{loc:T an.start}" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
