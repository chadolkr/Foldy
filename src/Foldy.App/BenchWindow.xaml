<Window x:Class="Foldy.App.BenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="clr-namespace:Foldy.UI.Controls;assembly=Foldy.UI"
        Title="Foldy 벤치"
        Icon="pack://application:,,,/Foldy.UI;component/Assets/foldy.ico"
        Width="1040" Height="680" MinWidth="640" MinHeight="400"
        Style="{DynamicResource Foldy.Window}">
  <DockPanel>
    <!-- 명령 줄: 뒤로/앞으로/위로 · 경로 · 새로 고침 · 더보기 -->
    <Border DockPanel.Dock="Top" Style="{DynamicResource Foldy.CommandBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
          <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72B;" ToolTip="뒤로 (Alt+←)" IsEnabled="False" />
          <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72A;" ToolTip="앞으로 (Alt+→)" IsEnabled="False" />
          <Button Style="{DynamicResource Foldy.ToolButton}" Content="&#xE74A;" ToolTip="위로 (Alt+↑)" Click="OnUpClick" />
        </StackPanel>
        <Border Grid.Column="1" Style="{DynamicResource Foldy.InputBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" Margin="10,0,0,0"
                   Source="pack://application:,,,/Foldy.UI;component/Assets/foldy-16.png"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <TextBox x:Name="PathBox" Grid.Column="1" KeyDown="OnPathKeyDown" />
            <!-- 진행선: 300ms 이후에만 보인다 (DESIGN.md 경과 시간별 표현) -->
            <Rectangle x:Name="ProgressLine" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Fill="{DynamicResource Brush.Progress}" Width="0" RadiusX="1" RadiusY="1" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
          <Button x:Name="RefreshButton" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE72C;" ToolTip="새로 고침 (F5)" Click="OnOpenClick" />
          <Button x:Name="CancelButton" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE711;" ToolTip="취소 (Esc)" IsEnabled="False" Click="OnCancelClick" />
          <Button x:Name="MoreButton" Style="{DynamicResource Foldy.ToolButton}" Content="&#xE712;" ToolTip="더 보기" Click="OnMoreClick">
            <Button.ContextMenu>
              <ContextMenu x:Name="MoreMenu">
                <MenuItem x:Name="ThemeSystem" Header="테마: 시스템 설정 따르기" Click="OnThemeClick" Tag="System" />
                <MenuItem x:Name="ThemeLight" Header="테마: 라이트" Click="OnThemeClick" Tag="Light" />
                <MenuItem x:Name="ThemeDark" Header="테마: 다크" Click="OnThemeClick" Tag="Dark" />
                <MenuItem x:Name="ThemeRetro" Header="테마: 레트로" Click="OnThemeClick" Tag="Retro" />
                <Separator />
                <MenuItem Header="벤치: 가짜 항목 100,000개 표시" Click="OnGenerate" />
                <MenuItem Header="벤치: 스크롤 측정" InputGestureText="F9" Click="OnScrollBench" />
                <MenuItem Header="Rust 복사 엔진 자체 시험" Click="OnCopySelfTest" />
                <MenuItem Header="색인 서비스 다시 연결" Click="OnReconnectIndexer" />
                <Separator />
                <MenuItem Header="Foldy 정보" Click="OnAbout" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 상태바 -->
    <Border DockPanel.Dock="Bottom" Style="{DynamicResource Foldy.StatusBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CountText" Style="{DynamicResource Foldy.StatusText}" Text="0개 항목" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{DynamicResource Foldy.StatusText}" Text="준비" />
        <TextBlock x:Name="IndexerText" Grid.Column="2" Style="{DynamicResource Foldy.StatusText}" Text="색인: 확인 중…" />
        <TextBlock x:Name="CopyEngineText" Grid.Column="3" Style="{DynamicResource Foldy.StatusText}" Text="복사 엔진: 확인 중…" />
      </Grid>
    </Border>

    <!-- 파일 목록 -->
    <Border Style="{DynamicResource Foldy.ListBorder}" Margin="8,0,8,0" ClipToBounds="True">
      <Grid>
        <ScrollViewer x:Name="FastScroller" CanContentScroll="True" Focusable="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <fc:FastFileList x:Name="FastList" Style="{DynamicResource Foldy.FileList}" />
        </ScrollViewer>

        <!-- 비교용: WPF 기본 ListView (명령줄 옵션 list-wpf) -->
        <fc:FileListView x:Name="FileList" Visibility="Collapsed" BorderThickness="0"
                         Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True">
          <fc:FileListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Height" Value="{DynamicResource List.RowHeight}" />
            </Style>
          </fc:FileListView.ItemContainerStyle>
          <fc:FileListView.View>
            <GridView>
              <GridViewColumn Header="이름" Width="380" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
              <GridViewColumn Header="수정한 날짜" Width="140" DisplayMemberBinding="{Binding ModifiedText, Mode=OneTime}" />
              <GridViewColumn Header="유형" Width="140" DisplayMemberBinding="{Binding TypeText, Mode=OneTime}" />
              <GridViewColumn Header="크기" Width="110" DisplayMemberBinding="{Binding SizeText, Mode=OneTime}" />
            </GridView>
          </fc:FileListView.View>
        </fc:FileListView>
      </Grid>
    </Border>
  </DockPanel>
</Window>
