<Window x:Class="Foldy.App.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="잠그고 닫기" Padding="12,3" Margin="6,0,0,0" Click="OnLockClose" />
        <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="저장 (Ctrl+S)" Padding="12,3" Margin="6,0,0,0" Click="OnSave" />
        <Button DockPanel.Dock="Right" x:Name="CaptureButton" Content="화면 캡처" Padding="12,3" Margin="6,0,0,0" Click="OnCapture"
                ToolTip="Windows 캡처 도구를 열어요. 캡처하면 바로 메모에 들어가요 (Win+Shift+S로 캡처한 뒤 Ctrl+V도 돼요)" />
        <ToggleButton DockPanel.Dock="Right" x:Name="ViewToggle" Content="보기로" Padding="12,3" Checked="OnModeToggle" Unchecked="OnModeToggle"
                      ToolTip="쓰기: 글과 미리 보기를 나란히 / 보기: 다 쓴 모습만" />
        <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="EditorColumn" Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               BorderThickness="0" Padding="12" FontFamily="{DynamicResource Font.Mono}" AllowDrop="True" VerticalContentAlignment="Top"
               Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}" />
      <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="1" IsToolBarVisible="False" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" />
    </Grid>
  </DockPanel>
</Window>
