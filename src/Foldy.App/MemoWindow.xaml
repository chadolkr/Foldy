<Window x:Class="Foldy.App.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="잠그고 닫기" Padding="12,3" Margin="6,0,0,0" Click="OnLockClose" ToolTip="저장하고 닫아요 (다시 열 때 암호가 필요해요)" />
        <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="저장 (Ctrl+S)" Padding="12,3" Margin="6,0,0,0" Click="OnSave" />
        <ToggleButton DockPanel.Dock="Right" x:Name="PreviewToggle" Content="미리 보기" Padding="12,3" IsChecked="True" Checked="OnPreviewToggle" Unchecked="OnPreviewToggle" />
        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                   Text="잠긴 메모 · 그림은 Ctrl+V로 붙여 넣거나 끌어다 놓으세요 · 5분 동안 손대지 않으면 저장하고 잠가요" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               BorderThickness="0" Padding="12" FontFamily="{DynamicResource Font.Mono}" AllowDrop="True" VerticalContentAlignment="Top"
               Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}" />
      <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="1" IsToolBarVisible="False" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" />
    </Grid>
  </DockPanel>
</Window>
