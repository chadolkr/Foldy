<Window x:Class="Foldy.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Foldy.UI.Views;assembly=Foldy.UI"
        xmlns:mascot="clr-namespace:Foldy.UI.Mascot;assembly=Foldy.UI"
        xmlns:jobs="clr-namespace:Foldy.Presentation.Jobs;assembly=Foldy.Presentation"
        xmlns:sb="clr-namespace:Foldy.Presentation.Sidebar;assembly=Foldy.Presentation"
        xmlns:svc="clr-namespace:Foldy.Presentation.Services;assembly=Foldy.Presentation"
        x:Name="Root"
        Title="Foldy"
        Icon="pack://application:,,,/Foldy.UI;component/Assets/foldy.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="420"
        Style="{DynamicResource Foldy.Window}">
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar" />
  </Window.TaskbarItemInfo>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- 사이드바를 접으면(아이콘만) 숨는 글자 -->
    <Style x:Key="SideLabel" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="{Binding SidebarExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}" />
    </Style>
    <Style x:Key="SideIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SideName" TargetType="TextBlock" BasedOn="{StaticResource SideLabel}">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SideHeaderRow" TargetType="DockPanel" BasedOn="{StaticResource SideLabel}">
      <Setter Property="LastChildFill" Value="True" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 공통 사이드바: 자주 쓰는 폴더·최근 폴더·드라이브·도구·설정 (접으면 아이콘만) -->
    <Border x:Name="Sidebar" Grid.RowSpan="4" Style="{DynamicResource Foldy.Sidebar}">
      <DockPanel>
        <!-- 맨 위: 접기/펼치기 -->
        <Button DockPanel.Dock="Top" Style="{DynamicResource Foldy.SideItem}" Margin="4,6,4,2" Click="OnToggleSidebar"
                ToolTip="사이드바 접기/펼치기 (Ctrl+Shift+B)" AutomationProperties.Name="사이드바 접기/펼치기">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE700;" />
            <TextBlock Style="{StaticResource SideName}" Text="Foldy" FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <!-- 맨 아래: 앱 공통 기능을 아이콘 한 줄로 (명령·업데이트·버그 신고·설정·도움말·더 보기). 이름은 툴팁. 사이드바를 접으면 세로로 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,6">
          <Rectangle Height="1" Margin="10,0,10,4" Fill="{DynamicResource Brush.Border}" />
          <WrapPanel HorizontalAlignment="Center" ItemWidth="34" ItemHeight="32">
          <Button Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnFnPalette" ToolTip="모든 명령 (Ctrl+Shift+P)" AutomationProperties.Name="모든 명령">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE765;" Margin="0" HorizontalAlignment="Center" />
          </Button>
          <Button Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnCheckUpdate" ToolTip="지금 새 버전 확인하고 설치" AutomationProperties.Name="업데이트">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE895;" Margin="0" HorizontalAlignment="Center" />
          </Button>
          <Button Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnReportBug" ToolTip="버그 신고 (앱·Windows 버전과 최근 기록을 채운 GitHub 이슈 작성 페이지)" AutomationProperties.Name="버그 신고">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xEBE8;" Margin="0" HorizontalAlignment="Center" />
          </Button>
          <Button Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnSettings" ToolTip="설정 (Ctrl+,)" AutomationProperties.Name="설정">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE713;" Margin="0" HorizontalAlignment="Center" />
          </Button>
          <Button Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnHelp" ToolTip="도움말 (F1)" AutomationProperties.Name="도움말">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE897;" Margin="0" HorizontalAlignment="Center" />
          </Button>
          <Button x:Name="MoreButton" Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnMore" ToolTip="테마, 숨김 파일, 목록 간격, 정보 등" AutomationProperties.Name="더 보기">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
          <Button.ContextMenu>
            <ContextMenu x:Name="MoreMenu">
              <MenuItem x:Name="ThemeSystem" Header="테마: 시스템 설정 따르기" Click="OnTheme" Tag="System" />
              <MenuItem x:Name="ThemeLight" Header="테마: 라이트" Click="OnTheme" Tag="Light" />
              <MenuItem x:Name="ThemeDark" Header="테마: 다크" Click="OnTheme" Tag="Dark" />
              <MenuItem x:Name="ThemeRetro" Header="테마: 레트로" Click="OnTheme" Tag="Retro" />
              <Separator />
              <MenuItem x:Name="ShowHiddenItem" Header="숨김 파일 보기" InputGestureText="Ctrl+H" Click="OnToggleHidden" />
              <MenuItem x:Name="DensityCompact" Header="목록 간격: 촘촘하게" Click="OnDensity" Tag="compact" />
              <MenuItem x:Name="DensityNormal" Header="목록 간격: 보통" Click="OnDensity" Tag="normal" />
              <MenuItem x:Name="DensityComfortable" Header="목록 간격: 널널하게" Click="OnDensity" Tag="comfortable" />
              <Separator />
              <MenuItem Header="템플릿으로 새 폴더…" InputGestureText="Ctrl+Shift+N" Click="OnMenuTemplate" />
              <MenuItem Header="폴더 위저드…" Click="OnMenuWizard" />
              <MenuItem Header="이 폴더 정리하기…" Click="OnMenuOrganize" />
              <MenuItem Header="폴더 설명 편집…" Click="OnMenuDescription" />
              <MenuItem Header="이미지만 보기" InputGestureText="Ctrl+Shift+I" Click="OnMenuImages" />
              <MenuItem Header="폴더 분석" Click="OnMenuAnalysis" />
              <Separator />
              <MenuItem Header="SFTP 서버에 연결…" InputGestureText="Ctrl+Shift+O" Click="OnSftpConnect" />
              <MenuItem Header="색인 서비스 설치 (관리자)…" Click="OnInstallIndexer" />
              <Separator />
              <MenuItem Header="설정…" InputGestureText="Ctrl+," Click="OnSettings" />
              <MenuItem Header="설정 파일 열기" Click="OnOpenSettings" />
              <MenuItem Header="도움말" InputGestureText="F1" Click="OnHelp" />
              <MenuItem Header="업데이트 확인…" Click="OnCheckUpdate" />
              <MenuItem Header="버그 신고…" Click="OnReportBug" />
              <MenuItem Header="버그 진단 모드 켜기/끄기" Click="OnToggleDiagnostic" />
              <MenuItem Header="로그 폴더 열기" Click="OnOpenLogs" />
            <MenuItem Header="Foldy 정보" Click="OnAbout" />
            </ContextMenu>
          </Button.ContextMenu>
          </Button>
          </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <!-- 자주 쓰는 폴더 (고정) -->
            <DockPanel Style="{StaticResource SideHeaderRow}">
              <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Width="26" Height="24" FontSize="11" Margin="0,8,8,0"
                      Content="&#xE718;" ToolTip="지금 폴더를 자주 쓰는 폴더에 고정" AutomationProperties.Name="지금 폴더 고정" Click="OnPinCurrent" />
              <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="자주 쓰는 폴더" />
            </DockPanel>
            <TextBlock x:Name="PinnedEmpty" Margin="14,2,10,4" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="핀 버튼으로 지금 폴더를 고정하세요." />
            <ItemsControl x:Name="PinnedList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type sb:QuickFolder}">
                  <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideFolder" Tag="{Binding}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="새 탭에서 열기" Click="OnSideFolderNewTab" Tag="{Binding}" />
                        <MenuItem Header="반대 패널에서 열기" Click="OnSideFolderOther" Tag="{Binding}" />
                        <Separator />
                        <MenuItem Header="위로" Click="OnPinUp" Tag="{Binding}" />
                        <MenuItem Header="아래로" Click="OnPinDown" Tag="{Binding}" />
                        <MenuItem Header="고정 해제" Click="OnUnpin" Tag="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource SideIcon}" Text="&#xE735;" Foreground="{DynamicResource Brush.Accent}" />
                      <TextBlock Style="{StaticResource SideName}" Text="{Binding Name}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 최근 폴더 (자동) -->
            <StackPanel x:Name="RecentSection" Style="{StaticResource SideLabel}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Width="26" Height="24" FontSize="11" Margin="0,8,8,0"
                        Content="&#xE74D;" ToolTip="최근 폴더 지우기" AutomationProperties.Name="최근 폴더 지우기" Click="OnClearRecent" />
                <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="최근 폴더" />
              </DockPanel>
              <ItemsControl x:Name="RecentList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sb:QuickFolder}">
                    <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideFolder" Tag="{Binding}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}" MinHeight="26">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="자주 쓰는 폴더에 고정" Click="OnPinFolder" Tag="{Binding}" />
                          <MenuItem Header="새 탭에서 열기" Click="OnSideFolderNewTab" Tag="{Binding}" />
                          <MenuItem Header="반대 패널에서 열기" Click="OnSideFolderOther" Tag="{Binding}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SideIcon}" Text="&#xE81C;" FontSize="12" />
                        <TextBlock Style="{StaticResource SideName}" Text="{Binding Name}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 드라이브와 남은 공간 -->
            <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="드라이브" Visibility="{Binding SidebarExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}" />
            <ItemsControl x:Name="SideDrives" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:DriveItem}">
                  <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideDrive" Tag="{Binding}" Padding="10,4" AutomationProperties.Name="{Binding Display}">
                    <Button.ToolTip>
                      <StackPanel>
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SpaceText}" />
                      </StackPanel>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="새 탭에서 열기" Click="OnSideDriveNewTab" Tag="{Binding}" />
                        <MenuItem Header="반대 패널에서 열기" Click="OnSideDriveOther" Tag="{Binding}" />
                        <MenuItem Header="폴더 분석" Click="OnSideDriveAnalyze" Tag="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DriveIcon" Style="{StaticResource SideIcon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Style="{StaticResource SideLabel}" Margin="10,0,0,0" Width="150">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="Bar" Height="5" Margin="0,4,0,3" Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}"
                                     Foreground="{DynamicResource Brush.Progress}" Background="{DynamicResource Brush.Border}" BorderThickness="0" />
                        <TextBlock Text="{Binding SpaceText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                      <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasSpace}" Value="False">
                      <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <!-- 아이콘은 지역 값으로 두면 트리거가 못 바꾸므로 둘 다 트리거로 준다. 클라우드 = Google Drive for desktop 등 -->
                    <DataTrigger Binding="{Binding Cloud}" Value="False">
                      <Setter TargetName="DriveIcon" Property="Text" Value="&#xEDA2;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Cloud}" Value="True">
                      <Setter TargetName="DriveIcon" Property="Text" Value="&#xE753;" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 도구: 네 묶음. 누르면 그 묶음의 기능 메뉴가 열린다 (사이드바가 한 화면에 들어가도록) -->
            <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="도구" Visibility="{Binding SidebarExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}" />
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="파일 검색, 폴더 분석, 이미지만 보기" AutomationProperties.Name="찾기">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="파일 이름 검색" Tag="search.focus" Click="OnGroupMenuItem" InputGestureText="Ctrl+F" />
                  <MenuItem Header="폴더 분석 (무엇이 공간을 차지하나)" Tag="analysis.open" Click="OnGroupMenuItem" />
                  <MenuItem Header="이미지만 보기" Tag="view.images" Click="OnGroupMenuItem" InputGestureText="Ctrl+Shift+I" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE721;" />
                <TextBlock Style="{StaticResource SideName}" Text="찾기" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="이 폴더 정리, 템플릿, 관리 방식, 바탕화면·다운로드·로그 정리" AutomationProperties.Name="정리하기">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="이 폴더 정리하기…" Tag="folder.organize" Click="OnGroupMenuItem" />
                  <MenuItem Header="템플릿으로 새 폴더…" Tag="folder.fromTemplate" Click="OnGroupMenuItem" InputGestureText="Ctrl+Shift+N" />
                  <MenuItem Header="폴더 위저드…" Tag="folder.wizard" Click="OnGroupMenuItem" />
                  <MenuItem Header="이 폴더 관리 방식 정하기…" Tag="folder.manage" Click="OnGroupMenuItem" />
                  <Separator />
                  <MenuItem Header="바탕화면 정리" Tag="cleanup.desktop" Click="OnGroupMenuItem" />
                  <MenuItem Header="다운로드 정리" Tag="cleanup.downloads" Click="OnGroupMenuItem" />
                  <MenuItem Header="로그 정리" Tag="cleanup.logs" Click="OnGroupMenuItem" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE8CB;" />
                <TextBlock Style="{StaticResource SideName}" Text="정리하기" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="휴지통 (백업·금고·잠긴 메모는 곧 들어와요)" AutomationProperties.Name="지키기">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="휴지통 열기" Tag="side.recycleBin" Click="OnGroupMenuItem" />
                  <MenuItem Header="휴지통 비우기…" Tag="app.emptyRecycleBin" Click="OnGroupMenuItem" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE72E;" />
                <TextBlock Style="{StaticResource SideName}" Text="지키기" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="SFTP·SSH, Git, 터미널" AutomationProperties.Name="연결하기">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="SFTP 서버에 연결…" Tag="sftp.connect" Click="OnGroupMenuItem" InputGestureText="Ctrl+Shift+O" />
                  <MenuItem Header="Git 화면 열기" Tag="git.open" Click="OnGroupMenuItem" />
                  <MenuItem Header="터미널" Tag="terminal.open" Click="OnGroupMenuItem" InputGestureText="Ctrl+`" />
                  <MenuItem Header="명령 프롬프트" Tag="terminal.cmd" Click="OnGroupMenuItem" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE71B;" />
                <TextBlock Style="{StaticResource SideName}" Text="연결하기" />
              </StackPanel>
            </Button>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideRecycleBin" ToolTip="Windows 휴지통 열기 (지운 파일 되살리기)" AutomationProperties.Name="휴지통">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource SideIcon}" Text="&#xE74D;" />
                  <TextBlock x:Name="RecycleBinText" Style="{StaticResource SideName}" Text="휴지통" />
                </StackPanel>
              </Button>
              <Button x:Name="EmptyRecycleBinButton" Grid.Column="1" Style="{DynamicResource Foldy.ToolButton}" Content="비우기" FontFamily="{DynamicResource Font.UI}" FontSize="11" Width="Auto" Padding="6,0" Margin="2,0,6,0"
                      ToolTip="휴지통 비우기 (영구 삭제, 되살릴 수 없음)" AutomationProperties.Name="휴지통 비우기" Click="OnEmptyRecycleBin" Visibility="Collapsed" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 좌우 패널 (각 패널 = 폴더 트리 | 파일 목록) -->
    <Grid x:Name="PanesGrid" Grid.Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="320" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <views:PaneView x:Name="LeftPane" />
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Border}" Focusable="False" />
      <views:PaneView x:Name="RightPane" Grid.Column="2" />
    </Grid>

    <!-- 작업 패널: 모달 없이 진행 표시 (설계서 2장 작업 패널·진행 표시) -->
    <!-- 정리 알림: 로그·다운로드가 많이 쌓였을 때 한 줄 (주 1회까지) -->
    <Border x:Name="CleanupNotice" Grid.Row="1" Grid.Column="1" Margin="8,0,8,6" Style="{DynamicResource Foldy.ListBorder}" Padding="10,5" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="닫기" Padding="8,2" Margin="6,0,0,0" Click="OnCleanupNoticeClose" />
        <Button DockPanel.Dock="Right" x:Name="CleanupNoticeButton" Padding="10,2" Margin="12,0,0,0" Click="OnCleanupNoticeOpen" />
        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="CleanupNoticeText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Border x:Name="JobsPanel" Grid.Row="2" Grid.Column="1" Margin="8,0,8,6" Style="{DynamicResource Foldy.ListBorder}" Padding="10,6" Visibility="Collapsed">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.CrumbButton}" Padding="8,2" Click="OnClearJobs">
            <TextBlock Text="완료된 작업 지우기" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Button>
          <TextBlock x:Name="JobsHeader" Text="작업" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="JobsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type jobs:JobViewModel}">
                <StackPanel Margin="0,3">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ProgressBar x:Name="Bar" Grid.Column="1" Height="4" Margin="10,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                               Foreground="{DynamicResource Brush.Progress}" Background="{DynamicResource Brush.Border}" BorderThickness="0" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                  <Button x:Name="CancelBtn" Grid.Column="3" Style="{DynamicResource Foldy.ToolButton}" Width="24" Height="24" FontSize="9"
                          Content="&#xE711;" ToolTip="취소" AutomationProperties.Name="작업 취소" Click="OnCancelJob" Tag="{Binding}" />
                </Grid>
                <mascot:MascotView Kind="{Binding MascotKind, Mode=OneTime}" State="{Binding State}" Progress="{Binding Progress}"
                                   IsMascotEnabled="{Binding MascotEnabled, Mode=OneTime}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Done}" />
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Canceled">
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 기능키 줄 -->
    <DockPanel Grid.Row="3" Grid.Column="1" Margin="8,0,8,4" x:Name="FnBar" LastChildFill="True">
      <DockPanel.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Margin" Value="0,0,6,0" />
          <Setter Property="Padding" Value="10,3" />
        </Style>
      </DockPanel.Resources>
      <!-- 파일 작업: 두 패널 너비에 고르게 (앱 공통 기능은 왼쪽 사이드바로 옮겼다) -->
      <UniformGrid Rows="1">
        <UniformGrid.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
        </UniformGrid.Resources>

        <Button Click="OnFnRename" ToolTip="이름 바꾸기">
          <TextBlock><Run Text="F2 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="이름 바꾸기" /></TextBlock>
        </Button>
        <Button Click="OnFnPreview" ToolTip="미리보기 창">
          <TextBlock><Run Text="F3 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="미리보기" /></TextBlock>
        </Button>
        <Button Click="OnFnCopy" ToolTip="반대 패널로 복사">
          <TextBlock><Run Text="F5 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="복사" /></TextBlock>
        </Button>
        <Button Click="OnFnMove" ToolTip="반대 패널로 이동">
          <TextBlock><Run Text="F6 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="이동" /></TextBlock>
        </Button>
        <Button Click="OnFnNewFolder" ToolTip="새 폴더 (Ctrl+Shift+N)">
          <TextBlock><Run Text="F7 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="새 폴더" /></TextBlock>
        </Button>
        <Button Click="OnFnDelete" ToolTip="휴지통으로 (Shift+Del: 영구 삭제)">
          <TextBlock><Run Text="Del " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="삭제" /></TextBlock>
        </Button>
      </UniformGrid>
    </DockPanel>

    <!-- 상태바: 메시지는 가운데에 크게, 새 메시지는 잠깐 강조색으로 깜빡인다 -->
    <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{DynamicResource Foldy.StatusBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectionText" Style="{DynamicResource Foldy.StatusText}" HorizontalAlignment="Left" />
        <Border x:Name="StatusPill" Grid.Column="1" Style="{DynamicResource Foldy.StatusPill}" Visibility="Collapsed">
          <Grid>
            <Border x:Name="StatusFlash" Background="{DynamicResource Brush.Accent}" CornerRadius="{Binding CornerRadius, ElementName=StatusPill}"
                    Margin="-10,-2" Opacity="0" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock x:Name="StatusText" Style="{DynamicResource Foldy.StatusMessage}" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DiagnosticBadge" Visibility="Collapsed" Click="OnToggleDiagnostic" Margin="0,2,8,2" Padding="8,0"
                  ToolTip="버그 진단 모드 켜짐 (상세 기록 중). 누르면 끄고 기록을 보낼지 묻습니다" Content="버그 진단 중"
                  Foreground="{DynamicResource Brush.Error}" BorderBrush="{DynamicResource Brush.Error}" />
          <TextBlock x:Name="IndexerText" Style="{DynamicResource Foldy.StatusText}" Text="색인: 확인 중…" />
          <TextBlock x:Name="CopyEngineText" Style="{DynamicResource Foldy.StatusText}" Text="복사 엔진: 확인 중…" />
          <Button x:Name="UpdateButton" Margin="4,2,8,2" Padding="10,1" Visibility="Collapsed" Click="OnInstallUpdate"
                  Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.AccentText}" BorderBrush="{DynamicResource Brush.Accent}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 명령 팔레트 (Ctrl+Shift+P) -->
    <Popup x:Name="Palette" Placement="Center" PlacementTarget="{Binding ElementName=PanesGrid}" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade">
      <Border Width="520" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,10,10">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <StackPanel>
          <Border Style="{DynamicResource Foldy.InputBorder}">
            <TextBox x:Name="PaletteInput" TextChanged="OnPaletteFilter" PreviewKeyDown="OnPaletteKey" />
          </Border>
          <ListBox x:Name="PaletteList" MaxHeight="320" Margin="0,6,0,0" BorderThickness="0" Background="Transparent"
                   MouseDoubleClick="OnPaletteRun" Foreground="{DynamicResource Brush.Text}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="4,3">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}" Foreground="{DynamicResource Brush.TextSecondary}" />
                  <TextBlock Text="{Binding Title}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
