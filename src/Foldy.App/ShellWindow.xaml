<Window x:Class="Foldy.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foldy.UI.Localization;assembly=Foldy.UI"
        xmlns:views="clr-namespace:Foldy.UI.Views;assembly=Foldy.UI"
        xmlns:mascot="clr-namespace:Foldy.UI.Mascot;assembly=Foldy.UI"
        xmlns:jobs="clr-namespace:Foldy.Presentation.Jobs;assembly=Foldy.Presentation"
        xmlns:sb="clr-namespace:Foldy.Presentation.Sidebar;assembly=Foldy.Presentation"
        xmlns:svc="clr-namespace:Foldy.Presentation.Services;assembly=Foldy.Presentation"
        x:Name="Root"
        Title="Foldy"
        Icon="pack://application:,,,/Foldy.UI;component/Assets/foldy.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="420"
        Style="{DynamicResource Foldy.Window}">
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar" />
  </Window.TaskbarItemInfo>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- 사이드바를 접으면(아이콘만) 숨는 글자 -->
    <Style x:Key="SideLabel" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="{Binding SidebarExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}" />
    </Style>
    <Style x:Key="SideIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SideName" TargetType="TextBlock" BasedOn="{StaticResource SideLabel}">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SideHeaderRow" TargetType="DockPanel" BasedOn="{StaticResource SideLabel}">
      <Setter Property="LastChildFill" Value="True" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 공통 사이드바: 자주 쓰는 폴더·최근 폴더·드라이브·도구·설정 (접으면 아이콘만) -->
    <Border x:Name="Sidebar" Grid.RowSpan="4" Style="{DynamicResource Foldy.Sidebar}">
      <DockPanel>
        <!-- 맨 위: 접기/펼치기. 폴더 트리 버튼과 같은 패널 아이콘·같은 켜짐 표시(눌린 배경). 옆에 Foldy 앱 아이콘 -->
        <Button x:Name="SidebarToggle" DockPanel.Dock="Top" Style="{DynamicResource Foldy.SideItem}" Margin="4,6,4,2" Click="OnToggleSidebar"
                ToolTip="{loc:T shell.sidebar.collapse.tip}" AutomationProperties.Name="{loc:T shell.sidebar.toggle}">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="SidebarToggleMark" Width="28" Height="28" Margin="-5,0,-5,0" CornerRadius="4" Background="{DynamicResource Brush.Selection}">
              <TextBlock Style="{StaticResource SideIcon}" Text="&#xE8A0;" HorizontalAlignment="Center" />
            </Border>
            <Image Source="pack://application:,,,/Foldy.UI;component/Assets/foldy-32.png" Width="20" Height="20" Margin="14,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Style="{StaticResource SideName}" Margin="6,0,0,0" Text="Foldy" FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <!-- 맨 아래: 설정·도움말·더 보기 (모든 명령·업데이트·버그 신고는 더 보기 안). 이름은 툴팁. 사이드바를 접으면 세로로 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,6">
          <Rectangle Height="1" Margin="10,0,10,4" Fill="{DynamicResource Brush.Border}" />
          <WrapPanel HorizontalAlignment="Center" ItemWidth="34" ItemHeight="32">
          <Button Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnSettings" ToolTip="{loc:T shell.settings.tip}" AutomationProperties.Name="{loc:T shell.settings}">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE713;" Margin="0" HorizontalAlignment="Center" />
          </Button>
          <Button x:Name="HelpButton" Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnHelpButton" ToolTip="{loc:T shell.help.tip}" AutomationProperties.Name="{loc:T shell.help}">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE897;" Margin="0" HorizontalAlignment="Center" />
            <Button.ContextMenu>
              <ContextMenu x:Name="HelpMenu">
                <MenuItem Header="{loc:T shell.help.shorts}" Click="OnShorts" />
                <MenuItem Header="{loc:T shell.help.manual}" InputGestureText="F1" Click="OnHelp" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="MoreButton" Style="{DynamicResource Foldy.SideItem}" HorizontalContentAlignment="Center" Padding="0" Margin="1" Click="OnMore" ToolTip="{loc:T shell.more.tip}" AutomationProperties.Name="{loc:T shell.more}">
            <TextBlock Style="{StaticResource SideIcon}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
          <Button.ContextMenu>
            <ContextMenu x:Name="MoreMenu">
              <MenuItem Header="{loc:T shell.allCommands}" InputGestureText="Ctrl+Shift+P" Click="OnFnPalette" />
              <Separator />
              <MenuItem x:Name="ThemeSystem" Header="{loc:T shell.theme.system}" Click="OnTheme" Tag="System" />
              <MenuItem x:Name="ThemeLight" Header="{loc:T shell.theme.light}" Click="OnTheme" Tag="Light" />
              <MenuItem x:Name="ThemeDark" Header="{loc:T shell.theme.dark}" Click="OnTheme" Tag="Dark" />
              <MenuItem x:Name="ThemeRetro" Header="{loc:T shell.theme.retro}" Click="OnTheme" Tag="Retro" />
              <Separator />
              <MenuItem x:Name="ShowHiddenItem" Header="{loc:T shell.showHidden}" InputGestureText="Ctrl+H" Click="OnToggleHidden" />
              <MenuItem x:Name="DensityCompact" Header="{loc:T shell.density.compact}" Click="OnDensity" Tag="compact" />
              <MenuItem x:Name="DensityNormal" Header="{loc:T shell.density.normal}" Click="OnDensity" Tag="normal" />
              <MenuItem x:Name="DensityComfortable" Header="{loc:T shell.density.relaxed}" Click="OnDensity" Tag="comfortable" />
              <Separator />
              <MenuItem Header="{loc:T shell.scale.system}" InputGestureText="Ctrl+0" Click="OnUiScale" Tag="0" />
              <MenuItem Header="{loc:T shell.scale.100}" Click="OnUiScale" Tag="1.0" />
              <MenuItem Header="{loc:T shell.scale.115}" Click="OnUiScale" Tag="1.15" />
              <MenuItem Header="{loc:T shell.scale.130}" Click="OnUiScale" Tag="1.3" />
              <MenuItem Header="{loc:T shell.scale.150}" InputGestureText="Ctrl+=" Click="OnUiScale" Tag="1.5" />
              <Separator />
              <MenuItem Header="{loc:T shell.editDescription}" Click="OnMenuDescription" />
              <MenuItem Header="{loc:T shell.installIndexer}" Click="OnInstallIndexer" />
              <Separator />
              <MenuItem Header="{loc:T shell.settingsMenu}" InputGestureText="Ctrl+," Click="OnSettings" />
              <MenuItem Header="{loc:T shell.openSettingsFile}" Click="OnOpenSettings" />
              <MenuItem Header="{loc:T shell.help}" InputGestureText="F1" Click="OnHelp" />
              <MenuItem Header="{loc:T shell.checkUpdate}" Click="OnCheckUpdate" />
              <MenuItem Header="{loc:T shell.aiConnect}" Click="OnMcp" />
              <MenuItem Header="{loc:T shell.reportBug}" Click="OnReportBug" />
              <MenuItem Header="{loc:T shell.tour}" Click="OnTour" />
              <MenuItem Header="{loc:T shell.diagnostic}" Click="OnToggleDiagnostic" />
              <MenuItem Header="{loc:T shell.openLogs}" Click="OnOpenLogs" />
            <MenuItem Header="{loc:T shell.about}" Click="OnAbout" />
            </ContextMenu>
          </Button.ContextMenu>
          </Button>
          </WrapPanel>
        </StackPanel>

        <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ScrollChanged="OnSidebarScrollChanged">
          <StackPanel>
            <!-- 대표 기능 넷: 한 번에 닿게 맨 위에 (사용자 2026-11-21, 조사 "Foldy 대표 기능 고르기"). 나머지는 아래 도구 묶음에 -->
            <Button Style="{DynamicResource Foldy.SideItem}" Tag="app.quickSearch" Click="OnGroupMenuItem" ToolTip="{loc:T side.find.tip}" AutomationProperties.Name="{loc:T side.find}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE721;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.find}" />
                <TextBlock Style="{StaticResource SideName}" Text="Ctrl+Space" FontSize="11" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Tag="analysis.open" Click="OnGroupMenuItem" ToolTip="{loc:T side.space.tip}" AutomationProperties.Name="{loc:T side.space}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xEDA2;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.space}" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Tag="cleanup.wizard" Click="OnGroupMenuItem" ToolTip="{loc:T side.tidy.tip}" AutomationProperties.Name="{loc:T side.tidy}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE8CB;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.tidy}" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Tag="folder.fromTemplate" Click="OnGroupMenuItem" ToolTip="{loc:T side.template.tip}" AutomationProperties.Name="{loc:T side.template}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE8F4;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.template}" />
              </StackPanel>
            </Button>

            <!-- 자주 쓰는 폴더 (고정) -->
            <DockPanel Style="{StaticResource SideHeaderRow}">
              <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Width="32" Height="32" FontSize="12" Margin="0,4,6,0"
                      Content="&#xE718;" ToolTip="{loc:T shell.pin.tip}" AutomationProperties.Name="{loc:T shell.pin}" Click="OnPinCurrent" />
              <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="{loc:T side.pinned}" />
            </DockPanel>
            <TextBlock x:Name="PinnedEmpty" Margin="14,2,10,4" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{loc:T shell.pin.empty}" />
            <ItemsControl x:Name="PinnedList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type sb:QuickFolder}">
                  <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideFolder" Tag="{Binding}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{loc:T shell.openNewTab}" Click="OnSideFolderNewTab" Tag="{Binding}" />
                        <MenuItem Header="{loc:T shell.openOtherPane}" Click="OnSideFolderOther" Tag="{Binding}" />
                        <Separator />
                        <MenuItem Header="{loc:T shell.moveUp}" Click="OnPinUp" Tag="{Binding}" />
                        <MenuItem Header="{loc:T shell.moveDown}" Click="OnPinDown" Tag="{Binding}" />
                        <MenuItem Header="{loc:T shell.unpin}" Click="OnUnpin" Tag="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource SideIcon}" Text="&#xE735;" Foreground="{DynamicResource Brush.Accent}" />
                      <TextBlock Style="{StaticResource SideName}" Text="{Binding Name}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 최근 폴더 (자동) -->
            <StackPanel x:Name="RecentSection" Style="{StaticResource SideLabel}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.ToolButton}" Width="32" Height="32" FontSize="12" Margin="0,4,6,0"
                        Content="&#xE74D;" ToolTip="{loc:T shell.clearRecent}" AutomationProperties.Name="{loc:T shell.clearRecent}" Click="OnClearRecent" />
                <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="{loc:T side.recent}" />
              </DockPanel>
              <ItemsControl x:Name="RecentList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sb:QuickFolder}">
                    <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideFolder" Tag="{Binding}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}" MinHeight="32">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{loc:T shell.pinFolder}" Click="OnPinFolder" Tag="{Binding}" />
                          <MenuItem Header="{loc:T shell.openNewTab}" Click="OnSideFolderNewTab" Tag="{Binding}" />
                          <MenuItem Header="{loc:T shell.openOtherPane}" Click="OnSideFolderOther" Tag="{Binding}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SideIcon}" Text="&#xE81C;" FontSize="12" />
                        <TextBlock Style="{StaticResource SideName}" Text="{Binding Name}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 드라이브와 남은 공간 -->
            <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="{loc:T side.drives}" Visibility="{Binding SidebarExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}" />
            <ItemsControl x:Name="SideDrives" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:DriveItem}">
                  <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideDrive" Tag="{Binding}" Padding="10,4" AutomationProperties.Name="{Binding Display}">
                    <Button.ToolTip>
                      <StackPanel>
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SpaceText}" />
                        <TextBlock Text="{Binding IndexText}" />
                      </StackPanel>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{loc:T shell.openNewTab}" Click="OnSideDriveNewTab" Tag="{Binding}" />
                        <MenuItem Header="{loc:T shell.openOtherPane}" Click="OnSideDriveOther" Tag="{Binding}" />
                        <MenuItem Header="{loc:T shell.analyze}" Click="OnSideDriveAnalyze" Tag="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DriveIcon" Style="{StaticResource SideIcon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Style="{StaticResource SideLabel}" Margin="10,0,0,0" Width="150">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="Bar" Height="5" Margin="0,4,0,3" Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}"
                                     Foreground="{DynamicResource Brush.Progress}" Background="{DynamicResource Brush.Border}" BorderThickness="0" />
                        <TextBlock Text="{Binding SpaceText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        <!-- 빠른 찾기(색인) 상태: 드라이브마다 한눈에 (사용자 2026-11-21) -->
                        <TextBlock x:Name="IndexLine" Text="{Binding IndexText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasIndexText, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                      <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasSpace}" Value="False">
                      <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <!-- 아이콘은 지역 값으로 두면 트리거가 못 바꾸므로 둘 다 트리거로 준다. 클라우드 = Google Drive for desktop 등 -->
                    <DataTrigger Binding="{Binding Cloud}" Value="False">
                      <Setter TargetName="DriveIcon" Property="Text" Value="&#xEDA2;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Cloud}" Value="True">
                      <Setter TargetName="DriveIcon" Property="Text" Value="&#xE753;" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 도구: 네 묶음. 누르면 그 묶음의 기능 메뉴가 열린다 (사이드바가 한 화면에 들어가도록) -->
            <TextBlock Style="{DynamicResource Foldy.SideHeader}" Text="{loc:T side.tools}" Visibility="{Binding SidebarExpanded, ElementName=Root, Converter={StaticResource BoolToVis}}" />
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="{loc:T shell.group.find.tip}" AutomationProperties.Name="{loc:T side.group.find}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:T shell.find.quick}" Tag="app.quickSearch" Click="OnGroupMenuItem" InputGestureText="Ctrl+Space" />
                  <MenuItem Header="{loc:T shell.find.name}" Tag="search.focus" Click="OnGroupMenuItem" InputGestureText="Ctrl+F" />
                  <MenuItem Header="{loc:T shell.find.analysis}" Tag="analysis.open" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.find.compare}" Tag="compare.panes" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.find.images}" Tag="view.images" Click="OnGroupMenuItem" InputGestureText="Ctrl+Shift+I" IsCheckable="False" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE721;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.group.find}" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="{loc:T shell.group.tidy.tip}" AutomationProperties.Name="{loc:T side.group.tidy}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:T shell.tidy.template}" Tag="folder.fromTemplate" Click="OnGroupMenuItem" InputGestureText="Ctrl+Shift+N" />
                  <MenuItem Header="{loc:T shell.tidy.wizard}" Tag="folder.wizard" Click="OnGroupMenuItem" />
                  <Separator />
                  <MenuItem Header="{loc:T shell.tidy.organize}" Tag="folder.organize" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.tidy.markDone}" Tag="tag.done" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.tidy.markApplied}" Tag="tag.반영 완료" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.tidy.method}" Tag="folder.manage" Click="OnGroupMenuItem" />
                  <Separator />
                  <MenuItem Header="{loc:T shell.tidy.desktop}" Tag="cleanup.desktop" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.tidy.downloads}" Tag="cleanup.downloads" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.tidy.logs}" Tag="cleanup.logs" Click="OnGroupMenuItem" />
                  <Separator />
                  <MenuItem Header="{loc:T shell.tidy.rebuildable}" Tag="cleanup.rebuildable" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.tidy.devcache}" Tag="cleanup.devcache" Click="OnGroupMenuItem" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE8CB;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.group.tidy}" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="{loc:T shell.group.protect.tip}" AutomationProperties.Name="{loc:T side.group.protect}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:T shell.protect.memo}" Tag="memo.new" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.protect.lockedMemo}" Tag="secure.newMemo" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.protect.lockFile}" Tag="secure.lock" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.protect.vault}" Tag="secure.vault" Click="OnGroupMenuItem" />
                  <Separator />
                  <MenuItem Header="{loc:T shell.protect.openBin}" Tag="side.recycleBin" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.protect.emptyBin}" Tag="app.emptyRecycleBin" Click="OnGroupMenuItem" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE72E;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.group.protect}" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideGroup" ToolTip="{loc:T shell.group.connect.tip}" AutomationProperties.Name="{loc:T side.group.connect}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:T shell.connect.sftp}" Tag="sftp.connect" Click="OnGroupMenuItem" InputGestureText="Ctrl+Shift+O" />
                  <MenuItem Header="{loc:T shell.connect.git}" Tag="git.open" Click="OnGroupMenuItem" />
                  <MenuItem Header="{loc:T shell.connect.terminal}" Tag="terminal.open" Click="OnGroupMenuItem" InputGestureText="Ctrl+`" />
                  <MenuItem Header="{loc:T shell.connect.cmd}" Tag="terminal.cmd" Click="OnGroupMenuItem" />
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SideIcon}" Text="&#xE71B;" />
                <TextBlock Style="{StaticResource SideName}" Text="{loc:T side.group.connect}" />
              </StackPanel>
            </Button>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{DynamicResource Foldy.SideItem}" Click="OnSideRecycleBin" ToolTip="{loc:T shell.bin.tip}" AutomationProperties.Name="{loc:T side.recycle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource SideIcon}" Text="&#xE74D;" />
                  <TextBlock x:Name="RecycleBinText" Style="{StaticResource SideName}" Text="{loc:T side.recycle}" />
                </StackPanel>
              </Button>
              <Button x:Name="EmptyRecycleBinButton" Grid.Column="1" Style="{DynamicResource Foldy.ToolButton}" Content="{loc:T shell.bin.empty}" FontFamily="{DynamicResource Font.UI}" FontSize="11" Width="Auto" Padding="6,0" Margin="2,0,6,0"
                      ToolTip="{loc:T shell.bin.empty.tip}" AutomationProperties.Name="{loc:T shell.bin.empty.name}" Click="OnEmptyRecycleBin" Visibility="Collapsed" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 사이드바 오른쪽 가장자리: 끌어서 넓히고 줄이기 (아주 좁히면 아이콘만, 다시 끌면 펼침). 파일 탐색기의 탐색 창과 같은 방식 -->
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="0" Grid.RowSpan="4" Width="9" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="CurrentAndNext" ResizeDirection="Columns" Cursor="SizeWE" Focusable="False"
                  ToolTip="{loc:T shell.splitter.sidebar}" DragCompleted="OnSidebarDragged" />

    <!-- 좌우 패널 (각 패널 = 폴더 트리 | 파일 목록) -->
    <Grid x:Name="PanesGrid" Grid.Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="320" />
        <ColumnDefinition Width="9" />
        <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <views:PaneView x:Name="LeftPane" />
      <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Brush.Border}" />
      <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" Cursor="SizeWE" ToolTip="{loc:T shell.splitter.panes}" />
      <views:PaneView x:Name="RightPane" Grid.Column="2" />
    </Grid>

    <!-- 작업 패널: 모달 없이 진행 표시 (설계서 2장 작업 패널·진행 표시) -->
    <!-- 정리 알림: 로그·다운로드가 많이 쌓였을 때 한 줄 (주 1회까지) -->
    <Border x:Name="CleanupNotice" Grid.Row="1" Grid.Column="1" Margin="8,0,8,6" Style="{DynamicResource Foldy.ListBorder}" Padding="10,5" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" x:Name="CleanupNoticeNever" Content="{loc:T suggest.never}" Padding="8,2" Margin="6,0,0,0" Click="OnNoticeNever" Visibility="Collapsed" />
        <Button DockPanel.Dock="Right" x:Name="CleanupNoticeClose" Content="{loc:T shell.close}" Padding="8,2" Margin="6,0,0,0" Click="OnCleanupNoticeClose" />
        <Button DockPanel.Dock="Right" x:Name="CleanupNoticeButton" Padding="10,2" Margin="12,0,0,0" Click="OnCleanupNoticeOpen" />
        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="CleanupNoticeText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Border x:Name="JobsPanel" Grid.Row="2" Grid.Column="1" Margin="8,0,8,6" Style="{DynamicResource Foldy.ListBorder}" Padding="10,6" Visibility="Collapsed">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{DynamicResource Foldy.CrumbButton}" Padding="8,2" Click="OnClearJobs">
            <TextBlock Text="{loc:T shell.jobs.clear}" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Button>
          <TextBlock x:Name="JobsHeader" Text="{loc:T shell.jobs}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="JobsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type jobs:JobViewModel}">
                <StackPanel Margin="0,3">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ProgressBar x:Name="Bar" Grid.Column="1" Height="4" Margin="10,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                               Foreground="{DynamicResource Brush.Progress}" Background="{DynamicResource Brush.Border}" BorderThickness="0" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                  <Button x:Name="CancelBtn" Grid.Column="3" Style="{DynamicResource Foldy.ToolButton}" Width="24" Height="24" FontSize="9"
                          Content="&#xE711;" ToolTip="{loc:T shell.cancel}" AutomationProperties.Name="{loc:T shell.jobs.cancel}" Click="OnCancelJob" Tag="{Binding}" />
                </Grid>
                <!-- 시작 전에 공간이 모자라 멈춘 작업: 그 드라이브 정리로 바로 가고, 정리한 뒤 같은 작업을 다시 (사용자 2026-11-22) -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                  <Button Content="{loc:T side.space}" ToolTip="{loc:T side.space.tip}" Padding="10,2" Margin="0,0,6,0" Click="OnJobFreeUp" Tag="{Binding}"
                          Visibility="{Binding CanFreeUp, Converter={StaticResource BoolToVis}}" />
                  <Button Content="{loc:T pane.retry}" ToolTip="{loc:T space.retryTip}" Padding="10,2" Click="OnJobRetry" Tag="{Binding}" />
                </StackPanel>
                <mascot:MascotView Kind="{Binding MascotKind, Mode=OneTime}" State="{Binding State}" Progress="{Binding Progress}"
                                   IsMascotEnabled="{Binding MascotEnabled, Mode=OneTime}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Done}" />
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Canceled">
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 기능키 줄 -->
    <DockPanel Grid.Row="3" Grid.Column="1" Margin="8,0,8,4" x:Name="FnBar" LastChildFill="True">
      <DockPanel.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Margin" Value="0,0,6,0" />
          <Setter Property="Padding" Value="10,3" />
        </Style>
      </DockPanel.Resources>
      <!-- 파일 작업: 두 패널 너비에 고르게 (앱 공통 기능은 왼쪽 사이드바로 옮겼다) -->
      <UniformGrid Rows="1">
        <UniformGrid.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
        </UniformGrid.Resources>

        <Button Click="OnFnRename" ToolTip="{loc:T shell.fn.rename}">
          <TextBlock><Run Text="F2 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{loc:T shell.fn.rename}" /></TextBlock>
        </Button>
        <Button Click="OnFnPreview" ToolTip="{loc:T shell.fn.preview.tip}">
          <TextBlock><Run Text="F3 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{loc:T shell.fn.preview}" /></TextBlock>
        </Button>
        <Button Click="OnFnCopy" ToolTip="{loc:T shell.fn.copy.tip}">
          <TextBlock><Run Text="F5 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{loc:T shell.fn.copy}" /></TextBlock>
        </Button>
        <Button Click="OnFnMove" ToolTip="{loc:T shell.fn.move.tip}">
          <TextBlock><Run Text="F6 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{loc:T shell.fn.move}" /></TextBlock>
        </Button>
        <Button Click="OnFnNewFolder" ToolTip="{loc:T shell.fn.newFolder.tip}">
          <TextBlock><Run Text="F7 " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{loc:T shell.fn.newFolder}" /></TextBlock>
        </Button>
        <Button Click="OnFnDelete" ToolTip="{loc:T shell.fn.delete.tip}">
          <TextBlock><Run Text="Del " Foreground="{DynamicResource Brush.TextSecondary}" /><Run Text="{loc:T shell.fn.delete}" /></TextBlock>
        </Button>
      </UniformGrid>
    </DockPanel>

    <!-- 상태바: 메시지는 가운데에 크게, 새 메시지는 잠깐 강조색으로 깜빡인다 -->
    <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{DynamicResource Foldy.StatusBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectionText" Style="{DynamicResource Foldy.StatusText}" HorizontalAlignment="Left" />
        <Border x:Name="StatusPill" Grid.Column="1" Style="{DynamicResource Foldy.StatusPill}" Visibility="Collapsed">
          <Grid>
            <Border x:Name="StatusFlash" Background="{DynamicResource Brush.Accent}" CornerRadius="{Binding CornerRadius, ElementName=StatusPill}"
                    Margin="-10,-2" Opacity="0" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock x:Name="StatusText" Style="{DynamicResource Foldy.StatusMessage}" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DiagnosticBadge" Visibility="Collapsed" Click="OnToggleDiagnostic" Margin="0,2,8,2" Padding="8,0"
                  ToolTip="{loc:T shell.diag.tip}" Content="{loc:T shell.diag}"
                  Foreground="{DynamicResource Brush.Error}" BorderBrush="{DynamicResource Brush.Error}" />
          <TextBlock x:Name="IndexerText" Style="{DynamicResource Foldy.StatusText}" Text="{loc:T shell.status.index}" />
          <TextBlock x:Name="CopyEngineText" Style="{DynamicResource Foldy.StatusText}" Text="{loc:T shell.status.engine}" />
          <Button x:Name="UpdateButton" Margin="4,2,8,2" Padding="10,1" Visibility="Collapsed" Click="OnInstallUpdate"
                  Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.AccentText}" BorderBrush="{DynamicResource Brush.Accent}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 명령 팔레트 (Ctrl+Shift+P) -->
    <Popup x:Name="Palette" Placement="Center" PlacementTarget="{Binding ElementName=PanesGrid}" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade">
      <Border Width="520" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,10,10">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <StackPanel>
          <Border Style="{DynamicResource Foldy.InputBorder}">
            <TextBox x:Name="PaletteInput" TextChanged="OnPaletteFilter" PreviewKeyDown="OnPaletteKey" />
          </Border>
          <ListBox x:Name="PaletteList" MaxHeight="320" Margin="0,6,0,0" BorderThickness="0" Background="Transparent"
                   MouseDoubleClick="OnPaletteRun" Foreground="{DynamicResource Brush.Text}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="4,3">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}" Foreground="{DynamicResource Brush.TextSecondary}" />
                  <TextBlock Text="{Binding Title}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
