<Window x:Class="Foldy.App.DesktopTidyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="바탕화면 정리" Width="760" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Text="바탕화면을 살펴보는 중…" TextWrapping="Wrap" />
      <TextBlock x:Name="Hint" Margin="0,4,0,10" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="닫기" MinWidth="75" IsCancel="True" Margin="8,0,0,0" Click="OnClose" />
      <Button DockPanel.Dock="Right" x:Name="OpenButton" Content="보관 폴더 열기" MinWidth="100" Margin="8,0,0,0" IsEnabled="False" Click="OnOpen" />
      <Button DockPanel.Dock="Right" x:Name="UndoButton" Content="되돌리기" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="OnUndo"
              ToolTip="지난번 바탕화면 정리로 옮긴 파일을 모두 제자리로" />
      <Button DockPanel.Dock="Right" x:Name="RunButton" Content="보관하기" MinWidth="90" IsDefault="True" IsEnabled="False" Click="OnRun" />
      <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
    <ListView x:Name="Items" BorderBrush="{DynamicResource Brush.Border}">
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,2" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="이름" Width="330">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Src}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="크기" Width="80" DisplayMemberBinding="{Binding SizeText}" />
          <GridViewColumn Header="옮길 곳" Width="300">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DstFolder}" ToolTip="{Binding Dst}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
