<Window x:Class="Foldy.App.LogCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="로그 정리" Width="760" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Text="로그 파일을 찾는 중…" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                 Text="7일 넘게 바뀌지 않은 *.log 파일을 같은 폴더의 logs-연-월.zip으로 묶습니다. 압축이 맞는지 다시 열어 확인한 뒤에만 원본을 휴지통으로 옮겨요. 프로그램이 쓰고 있는 로그와 Windows 폴더는 건드리지 않습니다." />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="닫기" MinWidth="75" IsCancel="True" Margin="8,0,0,0" Click="OnClose" />
      <Button DockPanel.Dock="Right" x:Name="RunButton" Content="압축하고 정리" MinWidth="110" IsDefault="True" IsEnabled="False" Click="OnRun" />
      <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
    <ListView x:Name="Groups" BorderBrush="{DynamicResource Brush.Border}">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="34">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="폴더" Width="380">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="달" Width="70" DisplayMemberBinding="{Binding Month}" />
          <GridViewColumn Header="파일" Width="56" DisplayMemberBinding="{Binding CountText}" />
          <GridViewColumn Header="크기" Width="80" DisplayMemberBinding="{Binding SizeText}" />
          <GridViewColumn Header="상태" Width="110" DisplayMemberBinding="{Binding State}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
