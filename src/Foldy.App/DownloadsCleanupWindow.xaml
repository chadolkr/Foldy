<Window x:Class="Foldy.App.DownloadsCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다운로드 정리" Width="760" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Text="다운로드 폴더를 살펴보는 중…" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                 Text="Foldy는 저절로 지우지 않아요. 필요 없는 건 휴지통에 버리거나, 나중에 볼지 모르면 보관하세요. 보관하기는 다운로드\보관\연-월 폴더로 옮깁니다." />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="닫기" MinWidth="75" IsCancel="True" Margin="8,0,0,0" Click="OnClose" />
      <Button DockPanel.Dock="Right" x:Name="ArchiveButton" Content="보관하기" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="OnArchive" />
      <Button DockPanel.Dock="Right" x:Name="RecycleButton" Content="휴지통으로" MinWidth="90" IsEnabled="False" Click="OnRecycle" />
      <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
    <ListView x:Name="Items" BorderBrush="{DynamicResource Brush.Border}">
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,2" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Width="34">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="이름" Width="300">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="크기" Width="80" DisplayMemberBinding="{Binding SizeText}" />
          <GridViewColumn Header="이유" Width="300">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
