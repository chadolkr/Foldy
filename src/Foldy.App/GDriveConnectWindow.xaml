<Window x:Class="Foldy.App.GDriveConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Drive" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource Foldy.Window}">
  <StackPanel Margin="20">
    <TextBlock Text="Google Drive" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBlock Text="Google 계정으로 로그인하면 Drive를 Foldy 탭에서 바로 열 수 있습니다. 설치할 프로그램은 없습니다."
               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,14" />

    <!-- 연결한 계정 -->
    <StackPanel x:Name="AccountsPanel">
      <TextBlock Text="연결한 계정" Foreground="{DynamicResource Brush.TextSecondary}" />
      <ListBox x:Name="AccountList" Margin="0,4,0,8" MinHeight="40" MaxHeight="220" MouseDoubleClick="OnOpen"
               SelectionChanged="OnSelectionChanged" Background="Transparent" BorderThickness="1"
               BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Text}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4,4">
              <TextBlock Text="{Binding Email}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button x:Name="OpenButton" Content="열기" MinWidth="80" Margin="0,0,8,0" Click="OnOpen" IsDefault="True" />
        <Button x:Name="DisconnectButton" Content="연결 끊기" MinWidth="80" Click="OnDisconnect"
                ToolTip="이 PC에서 계정 정보를 지우고 Google에 토큰 취소를 요청합니다. Drive의 파일은 그대로입니다." />
      </StackPanel>
    </StackPanel>

    <Button x:Name="AddButton" Content="Google 계정 연결…" HorizontalAlignment="Left" MinWidth="160" Click="OnAdd"
            ToolTip="기본 브라우저에서 Google 로그인 화면이 열립니다" />

    <!-- 로그인 대기 -->
    <Border x:Name="WaitPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12" CornerRadius="6"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="취소" MinWidth="70" Click="OnCancelSignIn" VerticalAlignment="Center" />
        <TextBlock x:Name="WaitText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                   Text="브라우저에서 Google 로그인을 마치세요. 끝나면 이 창이 저절로 바뀝니다." />
      </DockPanel>
    </Border>

    <!-- OAuth 클라이언트 (빌드에 없을 때, 또는 직접 바꿀 때) -->
    <Expander x:Name="ClientExpander" Header="고급: 내 OAuth 클라이언트 ID" Margin="0,16,0,0" Foreground="{DynamicResource Brush.Text}">
      <StackPanel Margin="0,8,0,0">
        <TextBlock x:Name="ClientHint" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
        <TextBlock Text="클라이언트 ID" Foreground="{DynamicResource Brush.TextSecondary}" />
        <Border Style="{DynamicResource Foldy.InputBorder}" Margin="0,4,0,8"><TextBox x:Name="ClientIdBox" /></Border>
        <TextBlock Text="클라이언트 보안 비밀번호 (데스크톱 앱 유형이면 필요)" Foreground="{DynamicResource Brush.TextSecondary}" />
        <Border Style="{DynamicResource Foldy.InputBorder}" Margin="0,4,0,8">
          <PasswordBox x:Name="ClientSecretBox" BorderThickness="0" Background="Transparent" Padding="6,0" VerticalContentAlignment="Center"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>
        <StackPanel Orientation="Horizontal">
          <Button Content="저장" MinWidth="80" Margin="0,0,8,0" Click="OnSaveClient" />
          <Button Content="지우기" MinWidth="80" Click="OnClearClient" />
        </StackPanel>
        <TextBlock Margin="0,8,0,0">
          <Hyperlink NavigateUri="https://github.com/chadolkr/Foldy/blob/main/docs/google-drive.md#oauth-클라이언트-만들기" RequestNavigate="OnLink">
            클라이언트 ID 만드는 방법
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </Expander>

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="닫기" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
