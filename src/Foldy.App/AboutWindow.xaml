<Window x:Class="Foldy.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foldy.UI.Localization;assembly=Foldy.UI"
        Title="{loc:T shell.about}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <StackPanel Margin="16">
    <StackPanel Orientation="Horizontal">
      <Image Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"
             Source="pack://application:,,,/Foldy.UI;component/Assets/foldy-32.png"
             RenderOptions.BitmapScalingMode="NearestNeighbor" />
      <StackPanel>
        <TextBlock FontSize="16" FontWeight="Bold" Text="Foldy" />
        <TextBlock Text="{loc:T tagline}" TextWrapping="Wrap" Margin="0,2,0,0" />
        <TextBlock Text="{loc:T tagline.sub}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" />
        <TextBlock x:Name="VersionText" Margin="0,2,0,8" />
        <TextBlock Text="{loc:T about.developer}" />
        <TextBlock Margin="0,2,0,0">
          <Run Text="{loc:T about.project}" />
          <Hyperlink NavigateUri="https://github.com/chadolkr/Foldy" RequestNavigate="OnNavigate">https://github.com/chadolkr/Foldy</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Run Text="{loc:T about.bug}" />
          <Hyperlink Click="OnReportBug" ToolTip="{loc:T about.bug.tip}"><Run Text="{loc:T about.bug.link}" /></Hyperlink>
          <Run Text=" · " />
          <Hyperlink NavigateUri="https://github.com/chadolkr/Foldy/issues" RequestNavigate="OnNavigate"><Run Text="{loc:T about.issues}" /></Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="360"
                   Text="{loc:T about.license}" />
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:T shell.reportBug}" MinWidth="90" Margin="0,0,8,0" Click="OnReportBug" />
      <Button Content="{loc:T set.ok}" MinWidth="75" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
