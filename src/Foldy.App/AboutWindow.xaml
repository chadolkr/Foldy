<Window x:Class="Foldy.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foldy 정보" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <StackPanel Margin="16">
    <StackPanel Orientation="Horizontal">
      <Image Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"
             Source="pack://application:,,,/Foldy.UI;component/Assets/foldy-32.png"
             RenderOptions.BitmapScalingMode="NearestNeighbor" />
      <StackPanel>
        <TextBlock FontSize="16" FontWeight="Bold" Text="Foldy" />
        <TextBlock x:Name="VersionText" Margin="0,2,0,8" />
        <TextBlock Text="개발자: David CHA" />
        <TextBlock Margin="0,2,0,0">
          <Run Text="배포·문의: " />
          <Hyperlink NavigateUri="https://github.com/chadolkr/Foldy-releases" RequestNavigate="OnNavigate">https://github.com/chadolkr/Foldy-releases</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Run Text="버그 제보: " />
          <Hyperlink Click="OnReportBug" ToolTip="앱·Windows 버전과 최근 로그를 채운 GitHub 이슈 작성 페이지를 엽니다">버그 신고…</Hyperlink>
          <Run Text=" · " />
          <Hyperlink NavigateUri="https://github.com/chadolkr/Foldy-releases/issues" RequestNavigate="OnNavigate">이슈 목록</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="360"
                   Text="Foldy는 무료로 쓰고 나눌 수 있는 프리웨어입니다 (소스 비공개). 사용권은 LICENSE, 사용한 오픈소스 구성 요소는 THIRD-PARTY-NOTICES.md를 보세요. 둘 다 설치 폴더에 있습니다." />
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="버그 신고…" MinWidth="90" Margin="0,0,8,0" Click="OnReportBug" />
      <Button Content="확인" MinWidth="75" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
