<Project Sdk="Microsoft.NET.Sdk">
  <!-- 모델과 추상화. 어떤 Foldy 프로젝트도 참조하지 않는다 (설계서 4장). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Foldy.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 금고·잠긴 메모: 표준 AES-256 zip (7-Zip·반디집에서도 열림). MIT 라이선스 -->
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Foldy.Core.Tests" />
    <InternalsVisibleTo Include="Foldy.Templates.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 내장 폴더 템플릿·사용법·위저드 규칙 (설계서 5.10). TemplateLibrary가 "Foldy.Templates.<파일명>"으로 읽는다. -->
    <EmbeddedResource Include="..\..\assets\templates\*.json;..\..\assets\templates\*.md" LogicalName="Foldy.Templates.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
