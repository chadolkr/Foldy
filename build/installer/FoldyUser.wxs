<?xml version="1.0" encoding="UTF-8"?>
<!--
  Foldy "나만 설치" MSI (1.19.0, WiX 6). 관리자 권한 없이 설치된다: %LOCALAPPDATA%\Programs\Foldy, 이 사용자만.
  빠른 찾기 도우미(색인 서비스, SYSTEM)는 넣지 않는다. Foldy가 서비스가 없는 것을 보고 사용자 권한으로 모든 드라이브를 모은다
  (변경 기록·메모리 찾기, 1.18.0). 업데이트는 앱이 이 MSI의 새 버전을 받아 UAC 없이 설치한다 (UserMsiInstall).
  모든 사용자용 MSI(Foldy.wxs)와 UpgradeCode가 달라 서로 덮어쓰지 않는다. 빌드: build/installer/build-msi.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Foldy (나만 설치)"
           Manufacturer="David CHA"
           Version="$(Version)"
           UpgradeCode="3F7C2A91-8B4E-4D6A-B1C5-7E92D04A6B18"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="Foldy - fast, smart file manager, even offline (just for me, no admin)" />

    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of Foldy is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FoldyIcon" SourceFile="$(RepoRoot)\assets\icons\foldy.ico" />
    <Property Id="ARPPRODUCTICON" Value="FoldyIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/chadolkr/Foldy" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/chadolkr/Foldy" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/chadolkr/Foldy/releases" />

    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(RepoRoot)\build\installer\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(RepoRoot)\build\installer\banner.bmp" />
    <!-- 라이선스 → 설치. 위치는 고르지 않는다 (사용자 폴더, 업데이트가 늘 같은 자리를 찾게) -->
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Foldy">

          <!-- 본체 + 시작 메뉴 바로가기. 사용자 폴더의 구성 요소는 사용자 레지스트리 값을 KeyPath로 둔다 (ICE38) -->
          <Component Id="FoldyExe" Guid="5D0B8E2C-41A7-4F3B-9C6E-2A8D7F1B3E90">
            <File Id="FoldyExeFile" Source="$(PayloadDir)\Foldy.exe">
              <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Foldy"
                        Description="빠르고 똑똑한 파일 관리자, 오프라인에서도" WorkingDirectory="INSTALLFOLDER"
                        Icon="FoldyIcon" Advertise="no" />
            </File>
            <RegistryValue Root="HKCU" Key="Software\Foldy\Install" Name="Folder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
            <ProgId Id="Foldy.LockedFile" Description="Foldy 잠긴 파일" Icon="FoldyExeFile" IconIndex="0">
              <Extension Id="foldylock" ContentType="application/x-foldy-lock">
                <Verb Id="open" Command="Foldy로 열기" TargetFile="FoldyExeFile" Argument="&quot;%1&quot;" />
              </Extension>
            </ProgId>
            <ProgId Id="Foldy.Vault" Description="Foldy 금고" Icon="FoldyExeFile" IconIndex="0">
              <Extension Id="foldyvault" ContentType="application/x-foldy-vault">
                <Verb Id="open" Command="Foldy로 열기" TargetFile="FoldyExeFile" Argument="&quot;%1&quot;" />
              </Extension>
            </ProgId>
          </Component>

          <!-- 단축키 도우미: Foldy가 꺼져 있어도 Ctrl+Space. 이 사용자의 로그인 때 시작 -->
          <Component Id="QuickSearchKey" Guid="9A4C1E7D-2B6F-4E8A-B3D5-6C1F0E9A2D47">
            <File Id="FoldyHotkeyExe" Source="$(PayloadDir)\foldy-hotkey.exe" />
            <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="Foldy Quick Search"
                           Type="string" Value="&quot;[#FoldyHotkeyExe]&quot;" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- 다시 설치·업데이트·제거: AI 연결용 Foldy(창 없음)와 이 사용자의 단축키 도우미는 끝내고 진행한다 (모든 사용자용 MSI와 같게) -->
    <CustomAction Id="EndAiConnectionFoldy" Directory="TARGETDIR"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoP -NonI -C &quot;gcim Win32_Process -F 'Name=''Foldy.exe''' | ? CommandLine -Match '\s--mcp' | icim -M Terminate; gcim Win32_Process -F 'Name=''foldy-hotkey.exe''' | icim -M Terminate&quot;"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="EndAiConnectionFoldy" Before="InstallValidate" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Foldy" Level="1" AllowAbsent="no">
      <ComponentRef Id="FoldyExe" />
      <ComponentRef Id="QuickSearchKey" />
      <ComponentGroupRef Id="PayloadFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**">
        <Exclude Files="$(PayloadDir)\Foldy.exe" />
        <Exclude Files="$(PayloadDir)\foldy-index.exe" />
        <Exclude Files="$(PayloadDir)\foldy-hotkey.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
