<Project>
  <!-- 패키지 버전은 이 파일에서만 올립니다 (중앙 패키지 관리). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="11.0.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <!-- 디스크 분석 DB (설계서 7.2/7.3): 최신 SQLite를 번들한 SQLitePCLRaw. OS의 sqlite에 기대지 않는다. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.15" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- 테스트 -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- FluentAssertions 8+는 상용 라이선스라 Apache-2.0 포크인 AwesomeAssertions 사용 (GPL 호환) -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>
</Project>
