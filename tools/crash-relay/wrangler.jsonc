{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foldy-crash-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "chadolkr/Foldy",
    "MAX_NEW_ISSUES_PER_DAY": "20",
    "MAX_COMMENTS_PER_ISSUE": "20"
  },
  // 서명 → 이슈 번호, 일일 상한 카운터. id는 `npm run setup`(scripts/setup.ps1)이 채운다.
  "kv_namespaces": [{ "binding": "CRASH_KV", "id": "REPLACE_WITH_KV_ID" }],
  // IP당 1분에 5건
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
  // GITHUB_TOKEN은 secret: `npx wrangler secret put GITHUB_TOKEN`
}
