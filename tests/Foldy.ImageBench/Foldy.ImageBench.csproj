<Project Sdk="Microsoft.NET.Sdk">
  <!-- 이미지 보기 벤치 (설계서 5.12 / 8.2 "이미지 1,000장 폴더"): 시험 이미지 생성과 썸네일 시간 측정. 테스트 패키지는 쓰지 않는다. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <PackageReference Remove="AwesomeAssertions" />
    <Using Remove="Xunit" />
    <Using Remove="AwesomeAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Foldy.Platform\Foldy.Platform.csproj" />
    <ProjectReference Include="..\..\src\Foldy.UI\Foldy.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestImages.cs" Link="Shared\TestImages.cs" />
  </ItemGroup>
</Project>
