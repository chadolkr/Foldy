{
  "schemaVersion": 1,
  "id": "client-project",
  "name": "고객·프로젝트 업무",
  "badge": "고객",
  "description": "계약부터 산출물까지 단계별 폴더 (외주·컨설팅·영업)",
  "purposes": ["work"],
  "variables": [
    { "key": "고객", "label": "고객사 이름", "required": true },
    { "key": "프로젝트", "label": "프로젝트 이름", "required": true }
  ],
  "tree": [
    { "name": "{{고객}}/{{date:yyyy-MM-dd}}_{{프로젝트}}", "children": [
      { "name": "01_계약", "nameEn": "01_contract" },
      { "name": "02_자료", "nameEn": "02_input" },
      { "name": "03_작업", "nameEn": "03_work" },
      { "name": "04_산출물", "nameEn": "04_deliverables" },
      { "name": "99_보관", "nameEn": "99_archive" },
      { "name": "README.md", "file": "# {{프로젝트}}\n\n고객: {{고객}}\n시작일: {{date:yyyy-MM-dd}}\n\n최종 산출물은 04_산출물에만 둡니다.\n" }
    ]}
  ],
  "naming": [
    {
      "pattern": "날짜_고객_문서종류_v버전.확장자",
      "examples": ["2026-11-18_ACME_제안서_v03.pptx", "2026-12-01_ACME_계약서_서명본.pdf"],
      "regex": "^\\d{4}-\\d{2}-\\d{2}_[^_]+_.+"
    }
  ],
  "firstSteps": [
    "받은 계약서·견적서를 01_계약에 날짜_고객_문서종류 이름으로 넣기",
    "고객에게 받은 자료는 손대지 말고 02_자료에 그대로 모으기",
    "보낸 최종본만 04_산출물에 두고, 나머지 작업 파일은 03_작업에"
  ],
  "organize": [
    { "target": "01_계약", "keywords": ["계약", "견적", "발주", "NDA", "contract", "quote", "invoice", "세금계산서"], "reason": "이름에 계약·견적" },
    { "target": "04_산출물", "keywords": ["최종", "final", "납품", "산출물", "deliverable"], "reason": "이름에 최종·납품" },
    { "target": "02_자료", "keywords": ["자료", "요청", "원본", "참고"], "reason": "이름에 자료·원본" },
    { "target": "03_작업", "groups": ["문서", "이미지", "코드"], "reason": "작업 파일" }
  ]
}
