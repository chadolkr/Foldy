{
  "schemaVersion": 1,
  "id": "ai-work",
  "name": "AI 작업 폴더",
  "badge": "PR",
  "category": "개발",
  "description": "프롬프트·데이터·결과·평가를 나눠 두는 AI 실험·작업 폴더",
  "purposes": [
    "dev",
    "work"
  ],
  "variables": [
    {
      "key": "작업",
      "label": "작업 이름 (폴더 이름)",
      "required": true
    }
  ],
  "tree": [
    {
      "name": "{{작업}}",
      "children": [
        {
          "name": "README.md",
          "file": "# {{작업}}\n\n무엇을 시험하는지, 어떤 모델을 썼는지, 결과가 어땠는지 적어 두세요.\n",
          "purpose": "무엇을 하는 작업인지 메모"
        },
        {
          "name": "prompts",
          "purpose": "프롬프트 (버전별로 v1, v2 …)"
        },
        {
          "name": "data",
          "purpose": "넣는 자료 (원본은 고치지 않기)"
        },
        {
          "name": "outputs",
          "purpose": "AI가 만든 결과 (날짜_프롬프트버전)"
        },
        {
          "name": "evals",
          "purpose": "결과를 비교·채점한 기록"
        }
      ]
    }
  ],
  "naming": [
    {
      "pattern": "날짜_프롬프트버전_내용",
      "examples": [
        "2026-11-20_v2_요약.md"
      ],
      "regex": "^\\d{4}-\\d{2}-\\d{2}_.+"
    }
  ],
  "firstSteps": [
    "README.md에 목표와 쓰는 모델 적기",
    "프롬프트는 prompts에 버전을 붙여 저장하기",
    "결과는 outputs에, 비교한 기록은 evals에 남기기"
  ],
  "organize": []
}
