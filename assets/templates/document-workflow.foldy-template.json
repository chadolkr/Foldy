{
  "schemaVersion": 1,
  "id": "document-workflow",
  "name": "문서 작성 단계",
  "badge": "문서",
  "category": "개인·업무",
  "description": "초안 → 검토 → 최종 → 배포, 문서가 진행 단계별로 이동하는 구조",
  "purposes": [
    "work"
  ],
  "variables": [
    {
      "key": "문서",
      "label": "문서(과제) 이름 (폴더 이름)",
      "required": true
    }
  ],
  "tree": [
    {
      "name": "{{문서}}",
      "children": [
        {
          "name": "01_초안",
          "nameEn": "01_draft",
          "purpose": "처음 쓰는 중"
        },
        {
          "name": "02_검토",
          "nameEn": "02_review",
          "purpose": "검토·피드백 받는 중"
        },
        {
          "name": "03_최종",
          "nameEn": "03_final",
          "purpose": "확정된 최종본"
        },
        {
          "name": "04_배포",
          "nameEn": "04_release",
          "purpose": "보낸 것·공유한 것"
        },
        {
          "name": "README.md",
          "file": "# {{문서}}\n\n시작일: {{date:yyyy-MM-dd}}\n\n## 진행 방법\n\n1. 01_초안에서 씁니다. 파일 이름 끝에 버전을 붙입니다 (v0.1, v0.2).\n2. 검토를 받을 때 02_검토로 복사하고 피드백을 같은 폴더에 둡니다.\n3. 확정되면 03_최종에 한 파일만 둡니다.\n4. 보낸 것(PDF 등)은 04_배포에 날짜와 함께 둡니다.\n"
        }
      ]
    }
  ],
  "naming": [
    {
      "pattern": "문서명_v버전_상태.확장자. 최종본은 날짜를 붙입니다",
      "examples": [
        "사업계획서_v0.2_초안.docx",
        "사업계획서_v1.0_최종_2026-11-18.docx"
      ]
    },
    {
      "folder": "{{문서}}/04_배포",
      "pattern": "날짜_문서명_받는곳.확장자",
      "examples": [
        "2026-11-18_사업계획서_투자사.pdf"
      ],
      "regex": "^\\d{4}-\\d{2}-\\d{2}_.+"
    }
  ],
  "firstSteps": [
    "01_초안에 첫 파일을 만들고 이름 끝에 v0.1 붙이기",
    "검토를 받을 때는 파일을 02_검토로 복사하기 (초안은 그대로 두기)",
    "확정된 파일은 03_최종에 한 개만 두고, 보낸 파일은 04_배포에 날짜와 함께 두기"
  ],
  "organize": [
    {
      "target": "01_초안",
      "keywords": [
        "초안",
        "draft"
      ],
      "reason": "이름에 초안"
    },
    {
      "target": "02_검토",
      "keywords": [
        "검토",
        "review",
        "수정",
        "피드백"
      ],
      "reason": "이름에 검토·수정"
    },
    {
      "target": "03_최종",
      "keywords": [
        "최종",
        "final"
      ],
      "reason": "이름에 최종"
    },
    {
      "target": "04_배포",
      "keywords": [
        "배포",
        "제출",
        "release",
        "발송"
      ],
      "reason": "이름에 배포·제출"
    }
  ]
}
