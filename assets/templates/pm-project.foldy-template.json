{
  "schemaVersion": 1,
  "id": "pm-project",
  "name": "프로젝트 관리 (PMBOK 5단계)",
  "badge": "PM",
  "category": "프로젝트",
  "description": "착수·계획·실행·감시와 통제·종료, PMI PMBOK의 다섯 프로세스 그룹대로 나누는 업종 공통 프로젝트 문서",
  "purposes": [
    "work"
  ],
  "variables": [
    {
      "key": "프로젝트",
      "label": "프로젝트 이름",
      "required": true
    }
  ],
  "tree": [
    {
      "name": "{{date:yyyy-MM-dd}}_{{프로젝트}}",
      "children": [
        {
          "name": "01_착수",
          "nameEn": "01_initiating",
          "purpose": "프로젝트 헌장, 이해관계자 목록, 승인 문서"
        },
        {
          "name": "02_계획",
          "nameEn": "02_planning",
          "purpose": "범위·일정(WBS)·예산·품질·위험·의사소통 계획"
        },
        {
          "name": "03_실행",
          "nameEn": "03_executing",
          "purpose": "만든 결과물, 회의록, 작업 자료"
        },
        {
          "name": "04_감시와통제",
          "nameEn": "04_monitoring_controlling",
          "purpose": "진척 보고, 변경 요청, 이슈·위험 기록"
        },
        {
          "name": "05_종료",
          "nameEn": "05_closing",
          "purpose": "최종 보고, 인수 확인, 교훈(회고), 계약 종료"
        },
        {
          "name": "99_보관",
          "nameEn": "99_archive",
          "purpose": "지난 버전·더는 안 쓰는 것"
        },
        {
          "name": "README.md",
          "file": "# {{프로젝트}}\n\n시작일: {{date:yyyy-MM-dd}}\n\nPMI PMBOK의 다섯 프로세스 그룹(착수·계획·실행·감시와 통제·종료) 순서로 문서를 둡니다.\n"
        }
      ]
    }
  ],
  "naming": [
    {
      "pattern": "날짜_프로젝트_문서종류_v버전.확장자",
      "examples": [
        "2026-11-21_고객포털_요구사항정의서_v01.docx",
        "2026-12-05_고객포털_주간보고.pptx"
      ],
      "regex": "^\\d{4}-\\d{2}-\\d{2}_[^_]+_.+"
    }
  ],
  "firstSteps": [
    "승인받은 프로젝트 헌장과 이해관계자 목록을 01_착수에 넣기",
    "일정·예산·위험 계획을 02_계획에 날짜_프로젝트_문서종류 이름으로 두기",
    "주간 보고와 변경 요청은 04_감시와통제에, 끝나면 최종 보고·교훈을 05_종료에"
  ],
  "organize": [
