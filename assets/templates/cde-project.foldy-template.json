{
  "schemaVersion": 1,
  "id": "cde-project",
  "name": "건설·설계 정보 관리 (ISO 19650 CDE)",
  "badge": "CDE",
  "category": "프로젝트",
  "description": "작업 중·공유·발행·보관, ISO 19650 공통 데이터 환경(CDE)의 네 상태로 도면·문서를 나누는 건설·설계 프로젝트",
  "purposes": [
    "work"
  ],
  "variables": [
    {
      "key": "프로젝트",
      "label": "프로젝트 이름",
      "required": true
    }
  ],
  "tree": [
    {
      "name": "{{date:yyyy-MM-dd}}_{{프로젝트}}",
      "children": [
        {
          "name": "01_작업중",
          "nameEn": "01_WIP",
          "purpose": "우리 팀이 고치는 중인 도면·모델·문서 (팀 안에서만)"
        },
        {
          "name": "02_공유",
          "nameEn": "02_Shared",
          "purpose": "다른 팀과 협의·검토하려고 내놓은 것"
        },
        {
          "name": "03_발행",
          "nameEn": "03_Published",
          "purpose": "승인받아 현장·발주처가 써도 되는 최종본"
        },
        {
          "name": "04_보관",
          "nameEn": "04_Archived",
          "purpose": "바뀌었거나 끝난 것 (기록으로 남김)"
        },
        {
          "name": "README.md",
          "file": "# {{프로젝트}}\n\n시작일: {{date:yyyy-MM-dd}}\n\nISO 19650 공통 데이터 환경(CDE)의 네 상태대로 둡니다: 작업 중 → 공유 → 발행 → 보관. 상태를 옮길 때는 정한 검토·승인을 거칩니다.\n"
        }
      ]
    }
  ],
  "naming": [
    {
      "pattern": "프로젝트_분야_문서종류_번호_개정.확장자",
      "examples": [
        "고객센터신축_건축_평면도_A101_P02.pdf",
        "고객센터신축_구조_계산서_S001_C01.pdf"
      ],
      "regex": "^[^_]+_[^_]+_.+"
    }
  ],
  "firstSteps": [
    "팀에서 고치는 파일은 01_작업중에만 두기",
    "검토받을 것은 02_공유로 옮기고, 승인되면 03_발행에 개정 번호를 붙여 두기",
    "새 개정이 나오면 예전 발행본은 지우지 말고 04_보관으로"
  ],
  "organize": [
    {
      "target": "03_발행",
      "keywords": [
        "승인",
        "발행",
        "최종",
        "approved",
        "issued",
        "published"
      ],
      "reason": "이름에 승인·발행"
    },
    {
      "target": "02_공유",
      "keywords": [
        "검토",
        "협의",
        "공유",
        "review",
        "shared"
      ],
      "reason": "이름에 검토·협의"
    },
    {
      "target": "04_보관",
      "notOpenedForDays": 365,
      "reason": "1년 넘게 열지 않음 → 보관 후보"
    }
  ]
}
