{
  "schemaVersion": 1,
  "id": "node-project",
  "name": "Node·TypeScript 프로젝트",
  "badge": "TS",
  "category": "개발",
  "description": "src, test, public 구조, dist·node_modules는 git에서 제외",
  "purposes": [
    "dev"
  ],
  "variables": [
    {
      "key": "프로젝트",
      "label": "프로젝트 이름 (폴더 이름)",
      "required": true
    }
  ],
  "tree": [
    {
      "name": "{{프로젝트}}",
      "children": [
        {
          "name": "src"
        },
        {
          "name": "src/index.ts",
          "file": "export function hello(name: string): string {\n  return `Hello, ${name}`;\n}\n"
        },
        {
          "name": "test"
        },
        {
          "name": "test/index.test.ts",
          "file": "import { hello } from \"../src/index\";\n\n// 테스트 도구(vitest, jest 등)를 정한 뒤 여기에 테스트를 씁니다.\nconsole.assert(hello(\"a\") === \"Hello, a\");\n"
        },
        {
          "name": "public",
          "optional": true
        },
        {
          "name": "docs",
          "optional": true
        },
        {
          "name": "package.json",
          "file": "{\n  \"name\": \"project\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"test\": \"echo 테스트 도구를 설정하세요\"\n  }\n}\n"
        },
        {
          "name": "tsconfig.json",
          "file": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"outDir\": \"dist\",\n    \"rootDir\": \".\"\n  },\n  \"include\": [\"src\", \"test\"]\n}\n"
        },
        {
          "name": "README.md",
          "file": "# {{프로젝트}}\n\n한 줄 소개를 여기에 씁니다.\n\n## 실행 방법\n\n```\n(빌드·실행 명령)\n```\n\n## 폴더 구조\n\n- `src/` 소스 (TypeScript)\n- `test/` 테스트\n- `public/` 그대로 제공하는 정적 파일\n- `dist/` 빌드 결과 (git 제외)\n"
        },
        {
          "name": ".gitignore",
          "file": "node_modules/\ndist/\ncoverage/\n.env\n.env.local\n*.log\n"
        }
      ]
    }
  ],
  "naming": [
    {
      "pattern": "파일은 kebab-case.ts, 컴포넌트·클래스는 PascalCase, 테스트는 이름.test.ts",
      "examples": [
        "file-list.ts",
        "FileList.tsx",
        "file-list.test.ts"
      ]
    },
    {
      "folder": "{{프로젝트}}/test",
      "pattern": "대상이름.test.ts",
      "examples": [
        "parser.test.ts"
      ],
      "regex": "^[a-z0-9-]+\\.test\\.tsx?$"
    }
  ],
  "firstSteps": [
    "package.json의 name을 정하고 npm install 로 의존성 설치하기",
    "테스트 도구(vitest 등)를 정하고 scripts.test 채우기",
    "dist·node_modules가 .gitignore에 들어 있는지 확인하고 git init 하기"
  ],
  "organize": [
    {
      "target": "docs",
      "extensions": [
        ".md",
        ".pdf",
        ".docx"
      ],
      "reason": "문서 → docs"
    },
    {
      "target": "public",
      "groups": [
        "이미지"
      ],
      "reason": "그림 → public"
    }
  ]
}
